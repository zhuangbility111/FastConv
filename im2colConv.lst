      600             				// memcpy(tmp, in_ptr, sizeof(float)*remain);
      601                             svst1_f32(pg, tmp,      svld1_f32(pg, in_ptr));
      602                             svst1_f32(pg, tmp + 16, svld1_f32(pg, in_ptr + 16));
      603             				tmp += COL_BATCH;
      604             				in_ptr += COL_BATCH;
      605             /*
