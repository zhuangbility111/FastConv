       88                                                               int &mc_begin, int &mc_end, int &mc_step, 
       89                                                               int &nc_begin, int &nc_end, int &nc_step, 
       90                                                               int &kc_begin, int &kc_end, int &kc_step) {
       91                 
       92                 int max_tuning_num = 1024;
       93             
       94                 // int mc_num = ((M < 128 ? M : 128) - 1) / row_batch + 1;
       95                 int mc_num = (M - 1) / row_batch + 1;
       96                 int nc_num = (N - 1) / col_batch + 1;
       97                 int kc_num = (K < 8 ? K : 8);
       98             
       99                 if(mc_num * nc_num > max_tuning_num)	{
      100                     //OC will be divided at most 64 parts.
      101                     if(mc_num >= 64)	          
      102                         mc_num = 64;	
      103                     //All the others will be used on tile
      104                     if(nc_num > max_tuning_num / mc_num)  
      105                         nc_num = max_tuning_num / mc_num; 
      106                 }
      107             
      108                 int M_step = (M - 1) / (row_batch * mc_num) + 1;
