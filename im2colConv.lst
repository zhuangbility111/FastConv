      665         2                   }
      666                         // remain numbers of elems are across several rows
      667             			} else {
      668              				for (int i = oh_begin_idx; i <= oh_end_idx; i++) {
      669              					int j_begin = 0, j_end = output_width-1;
      670              					if (i == oh_begin_idx) {
