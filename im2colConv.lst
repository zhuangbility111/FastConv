      408                 total.printBench("Total time:", iterations);
      409             
      410                 double gflops = (2.0 * this->M * this->N * this->K) / 1000000.0 / total.getBench(iterations);
      411                 double efficiency = gflops / 128.0 * 100.0;
      412                 printf("M = %d, N = %d, K = %d\n", this->M, this->N, this->K);
      413                 printf("Efficency: %lf \%, GFlops: %lf \n", efficiency, gflops);
      414             
      415                 // float *output_data_ref = new float[M * N + 32];
      416                 // memset(output_data_ref, 0, sizeof(float) * (M * N + 32));
      417                 // GEMM(kernel_data, transform_input_data, output_data_ref);
      418                 // if (output_data_ref != NULL)
      419                 //   float dis = diff(output_data_ref, output_data, this->M, this->N);
      420             	// delete [] output_data_ref;
      421             
      422             //    printf_matrix(output_data, M, N);
      423             //    printf("---------------\n");
      424             //    printf_matrix(output_data_ref, M, N);
      425             
      426             
      427                 // printf("c[0] = %f, c[1] = %f, c[2] = %f\n", output_data[0], output_data[1], output_data[2]);
      428                 // printf("c_ref[0] = %f, c_ref[1] = %f, c_ref[2] = %f\n", output_data_ref[0], output_data_ref[1], output_data_ref[2]);
      429                 if (output_ref != NULL)
      430                     float dis = diff(output_ref, output_data, output_channels *  output_height * output_width);
      431                 
      432             
      433    i            return 1;
      434             }
