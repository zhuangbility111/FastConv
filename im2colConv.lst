      436             int ConvIm2colLayer::Tuning() {
      437                 const char *log_path;
      438                 bool is_log_entry_exist = false;
      439                 if(opendir("./gemm_log") == nullptr)
      440                     mkdir("./gemm_log", 0775);
      441             #ifdef __APPLE__
      442                 log_path = "./gemm_log/mac_tuning_log";
      443             #else
      444                 log_path = "./gemm_log/linux_tuning_log";
      445             #endif
      446             
      447                 is_log_entry_exist = search_log_file_and_entry(log_path);
      448                 if (is_log_entry_exist) {   // the entry exists
      449                     printf("log entry exists.\n");
      450             	return 1;
      451                 } else {     // the entry dosen't exist
      452                     printf("log entry doesn't exist.\n");
      453                     int best_mc, best_nc, best_kc, best_rb, best_cb, best_pc, best_pb, best_pre_a, best_pre_b, best_pre_c;
      454                     this->search_best_param(best_mc, best_nc, best_kc, best_rb, best_cb, best_pc, best_pb, best_pre_a, best_pre_b, best_pre_c);
      455                     this->write_best_param(log_path, best_mc, best_nc, best_kc, best_rb, best_cb, best_pc, best_pb, best_pre_a, best_pre_b, best_pre_c);
      456                 }
      457                 return 1;
      458             }
      459             
      460             void ConvIm2colLayer::im2col() {
      461                 int stride = output_height * output_width * kernel_height * kernel_width;
      462                 float* ret = transform_input_data;
      463                 for (int ic = 0; ic < input_channels; ic++) {
      464                     int ret_idx = ic * stride;
      465                     for (int u = 0; u < kernel_height; u++) {
      466                         for (int v = 0; v < kernel_width; v++) {
      467                             for (int i = 0; i < output_height; i++) {
                       <<< Loop-information Start >>>
                       <<<  [OPTIMIZATION]
                       <<<    PREFETCH(SOFT) : 2
                       <<<     SEQUENTIAL : 2
                       <<<      (unknown): 2
                       <<< Loop-information  End >>>
      468                                 for (int j = 0; j < output_width; j++) {
      469                                     int row = u - padding_top + i * stride_height;
      470                                     int col = v - padding_left + j * stride_width;
      471                                     if (row < 0 || row >= input_height || col < 0 || col >= input_width) {
      472                                         ret[ret_idx] = 0;
      473                                     }
      474                                     else {
      475                                         int idx = ic * input_height * input_width + row * input_width + col;
      476                                         ret[ret_idx] = input_data[idx];
      477                                     }
      478                                     ++ret_idx;
      479                                 }
      480                             }
      481                         }
      482                     }
      483                 }
      484             }
      485             
      486             void ConvIm2colLayer::im2col_v1() {
      487                 int padding_input_width  = input_width  + padding_left + padding_right;
      488                 int padding_input_height = input_height + padding_top  + padding_bottom;
      489                 int padding_input_size   = padding_input_height * padding_input_width;
      490                 int input_size = input_height * input_width;
      491             
      492                 float* padding_input_data = static_cast<float*>(_mm_malloc(sizeof(float) * padding_input_size * input_channels, 64));
      493                 memset(padding_input_data, 0, sizeof(float) * padding_input_size * input_channels);
      494             
      495                 for (int ic = 0; ic < input_channels; ic++) {
      496                     float* padding_input_ptr = padding_input_data + ic * padding_input_size + padding_top * padding_input_width + padding_left;
      497                     float* input_ptr         = input_data + ic * input_size;
      498                     for (int row = 0; row < input_height; row++) {
      499                         memcpy(padding_input_ptr, input_ptr, sizeof(float) * input_width);
      500                         padding_input_ptr += padding_input_width;
      501                         input_ptr += input_width;
      502                     }
      503                 }
      504                 int transform_input_height = input_channels * kernel_height * kernel_width;
      505                 int transform_input_width  = output_height  * output_width;
      506                 int transform_input_size = transform_input_height * transform_input_width;
      507                 float* in, *in_ptr, *in_ptr_copy;
      508                 float* transform_in_ptr = transform_input_data;
      509             
      510             
      511                 int padding_width = padding_left + padding_right;
      512                 int step = stride_height * padding_input_width;
      513                 // input transform
      514                 for (int ic = 0; ic < input_channels; ic++) {
      515                     in = padding_input_data + ic*padding_input_size;
      516                     for (int u = 0; u < kernel_height; u++) {
      517                         for (int v = 0; v < kernel_width; v++) {
      518                             in_ptr_copy = in + u*padding_input_width + v;
      519                             for (int i = 0; i < output_height; i++) {
      520                                 in_ptr = in_ptr_copy + i*step;
                       <<< Loop-information Start >>>
                       <<<  [OPTIMIZATION]
                       <<<    PREFETCH(SOFT) : 2
                       <<<     SEQUENTIAL : 2
                       <<<      (unknown): 2
                       <<< Loop-information  End >>>
      521                                 for (int j = 0; j < output_width; j++) {
      522                                     *transform_in_ptr = *in_ptr;
      523                                     ++transform_in_ptr;
      524                                     in_ptr += stride_width;
      525                                 }
      526                             }
      527                         }
      528                     }
      529                 }
      530             	// fill_test_data(kernel_data, M, K);
      531                 // fill_test_data(transform_input_data, K, N);
      532             }
      533             
      534             void ConvIm2colLayer::padding_input() {
      535                 int padding_input_width  = input_width  + padding_left + padding_right;
      536                 int padding_input_height = input_height + padding_top  + padding_bottom;
      537                 int padding_input_size   = padding_input_height * padding_input_width;
      538                 int input_size = input_height * input_width;
      539             
      540                 for (int ic = 0; ic < input_channels; ic++) {
      541                     float* padding_input_ptr = padding_input_data + ic * padding_input_size + padding_top * padding_input_width + padding_left;
      542                     float* input_ptr         = input_data + ic * input_size;
      543                     for (int row = 0; row < input_height; row++) {
      544                         memcpy(padding_input_ptr, input_ptr, sizeof(float) * input_width);
      545                         padding_input_ptr += padding_input_width;
      546                         input_ptr += input_width;
      547                     }
      548                 }
      549             }
