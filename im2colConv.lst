      328             void ConvIm2colLayer::write_best_param(const char *log_path, int &best_mc, int &best_nc, int &best_kc, int &best_rb, int &best_cb, 
      329                                                    int &best_pc, int &best_pb, int &best_pre_a, int &best_pre_b, int &best_pre_c) {
      330                 FILE *log_file = fopen(log_path, "a+");
