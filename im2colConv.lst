      699             
      700             void ConvIm2colLayer::sgemm() {
      701                 switch(gemm_version) {
      702                     case GEMM_NO_BLOCKS:
      703                         GEMM(kernel_data, transform_input_data, output_data);
      704                     break;
      705             
      706                     case GEMM_BLOCKS_SINGLE_THREAD:
      707                         GEMM_v3(kernel_data, transform_input_data, output_data);
      708                         // GEMM_v2(kernel_data, transform_input_data, output_data);
      709                         // GEMM_v5_MNK(kernel_data, transform_input_data, output_data);
      710             
      711                     break;
      712             
      713                     case GEMM_BLOCKS_MULTI_THREADS:
      714                         GEMM_multithread(kernel_data, transform_input_data, output_data);
      715                     break;
      716                 }
      717             }
      718             
      719             void ConvIm2colLayer::GEMM(float* A, float* B, float* C) {
      720                 int A_row = M;
      721                 int A_col = K;
      722                 int B_row = K;
      723                 int B_col = N;
      724                 int C_row = A_row;
      725                 int C_col = B_col;
      726             
      727                 // 这个版本虽然访存连续，但是矩阵B会被重复读取outputChannel次，增加了访存次数
      728                 // 因此需要考虑分块，使矩阵中每一个块只需要被读一次，在访存连续的情况下，减少访存次数
      729             /*
      730                float* B_ptr;
      731                for (int k = 0; k < A_row; k++)
      732                {
      733                    B_ptr = B;
      734                    for (int i = 0; i < A_col; i++) 
      735                    {
      736                       float temp = *(A + k*A_col + i);
      737                        for (int j = 0; j < B_col; j++)
      738                        {
      739                            *(C + k*C_col + j) += temp * *B_ptr;
      740                            ++B_ptr;
      741                        }
      742                    }
      743                }
      744             */
      745                 for(int i=0;i<A_row;i++){
      746                     for(int j=0;j<B_col;j++){
      747         2               for(int k=0;k<A_col;k++){
      748         2                   *(C + i * C_col + j ) += *(A + i * A_col + k) * *(B + k * B_col + j);
      749         2               }
      750                     }
      751                 }
      752             }
      753             
      754             void ConvIm2colLayer::GEMM_v2(float* A, float* B, float* C) {
      755                 int lda = K;
      756                 int ldb = N;
      757                 int ldc = N;
      758             
      759    i            Timer packA_timer;
      760    i            Timer packB_timer;
      761    i            Timer kernel_timer;
      762             
      763                 // 保证row_batch 能被 mc整除，否则会有bug
      764             
      765                 int packB_width;
      766                 int packB_height;
      767                 int packBC_width;
      768                 int packBC_height;
      769             
      770                 packBC_height = kc + mc;
      771                 packBC_width = align_ceil(nc, col_batch);
      772                 packB_height = kc;
      773                 packB_width = packBC_width;
      774                 // float *packB = new float[(kc + mc) * nc_ceil];
      775                 // float *packC = packB + kc * nc_ceil;
      776             
      777                 // float *packA = new float[M * kc]; 
      778                 // float *packB = new float[packBC_height * packBC_width];
      779                 float *packA = static_cast<float*>(_mm_malloc((M * kc + 16) * sizeof(float))); 
      780                 float *packB = static_cast<float*>(_mm_malloc((packBC_height * packBC_width + 16) * sizeof(float)));
      781                 float *packC = C;
      782                 if (this->pack_c_version != 0)
      783                     packC = packB + packB_height * packB_width;
      784                 // A中的一大整列M * kc，B中的一大整行kc * N
      785                 for (int kt = 0; kt < K; kt += kc)
      786                 {
      787                     int kc_adjust = min(kc, K - kt);
      788                     // packA_timer.startBench();
      789                     // 对A的一大整列做packing
      790                     this->pack_a(M, kc_adjust, A + kt, lda, packA, mc, kc, nc, row_batch, col_batch);
      791                     // packA_timer.accumBench();
      792                     // B中的一大块kc * nc
      793                     for (int nt = 0; nt < N; nt += nc)
      794                     {
      795                         int nc_adjust = min(nc, N - nt);
      796                         int nc_ceil = align_ceil(nc_adjust, col_batch);
      797                         float *packB_copy = packB;
      798             
      799             	    // packB_timer.startBench();
      800                         // 对B的一大块kc * nc做packing
      801                         this->pack_b(kc_adjust, nc_adjust, B + kt*ldb + nt, ldb, packB_copy, row_batch, col_batch);
      802                         // packB_timer.accumBench();
      803             
      804                         // 接着就是对A的一大列M * kc和B的一大块kc * nc进行计算
      805                         // 选择A的一大列的一小块
      806                         for (int mt = 0; mt < M; mt += mc)
      807                         {
      808                             int mc_adjust = min(mc, M - mt);
      809                             float *C_copy = C + mt * ldc + nt;
      810                             float *packC_copy;
      811                             int packC_ptr_step;
      812                             int packC_copy_step;
      813                             int packC_col;
      814             
      815                             if (this->pack_c_version == 0) {
      816                                 packC_ptr_step = 1;
      817                                 packC_copy_step = ldc;
      818                                 packC_copy = C_copy;
      819                                 packC_col = ldc;
      820                             }
      821                             else if (this->pack_c_version == 1) {
      822                                 packC_ptr_step = 1;
      823                                 packC_copy_step = nc_ceil;
      824                                 packC_copy = packC;
      825                                 packC_col = nc_ceil;
      826                             }
      827                             else if (this->pack_c_version == 2) {
      828                                 packC_ptr_step = mc_adjust;
      829                                 packC_copy_step = col_batch;
      830                                 packC_copy = packC;
      831                                 packC_col = nc_ceil;
      832                             }
      833             
      834                             // kernel_timer.startBench();
      835                             if (this->pack_c != nullptr)
      836                                 this->pack_c(mc_adjust, nc_adjust, nc_ceil, C_copy, packC_copy, ldc, row_batch, col_batch);
      837             
      838                             int start_remain_row = mc_adjust - mc_adjust % row_batch;
      839                             int step = col_batch * kc_adjust;
      840                             // 每次计算 row_batch 行
      841                             int i = 0;
      842                             for (; i < start_remain_row; i += row_batch) 
      843                             {
      844                                 float *packA_ptr = packA + (mt + i) * kc_adjust;
      845                                 float *packB_ptr = packB_copy;
      846                                 float *packC_copy_copy = packC_copy + i * packC_copy_step;
      847                                 float *packC_ptr;
      848                                 // 每次计算 col_batch 列。不足 col_batch 列的补0处理，因此也当成 col_batch 列进行计算
                       <<< Loop-information Start >>>
                       <<<  [OPTIMIZATION]
                       <<<    SPILLS :
                       <<<      GENERAL   : SPILL 0  FILL 1
                       <<<      SIMD&FP   : SPILL 0  FILL 0
                       <<<      SCALABLE  : SPILL 0  FILL 0
                       <<<      PREDICATE : SPILL 0  FILL 0
                       <<< Loop-information  End >>>
      849                                 for (int j = 0; j < nc_ceil; j += col_batch)
      850          s                      {
      851          s                          packC_ptr = packC_copy_copy + j * packC_ptr_step;
      852          s                          this->inner_kernel(kc_adjust, packA_ptr, packB_ptr, packC_ptr, packC_col, prefetch_a, prefetch_b, prefetch_c);
      853          s                          packB_ptr += step;
      854          s                      }
      855                             }
      856             
      857                             // 剩余不足 row_batch 行，单独处理
      858                             if (i < mc_adjust) {
      859                                 float *packA_ptr = packA + (mt + i) * kc_adjust;
      860                                 float *packB_ptr = packB_copy;
      861                                 float *packC_copy_copy = packC_copy + i * packC_copy_step;
      862                                 float *packC_ptr;
      863                                 int num_remain_row = mc_adjust - start_remain_row;
      864                                 //  每次计算 col_batch 列。不足 col_batch 列的补0处理，因此也当成 col_batch 列进行计算
                       <<< Loop-information Start >>>
                       <<<  [OPTIMIZATION]
                       <<<    SPILLS :
                       <<<      GENERAL   : SPILL 0  FILL 1
                       <<<      SIMD&FP   : SPILL 0  FILL 0
                       <<<      SCALABLE  : SPILL 0  FILL 0
                       <<<      PREDICATE : SPILL 0  FILL 0
                       <<< Loop-information  End >>>
      865                                 for (int j = 0; j < nc_ceil; j += col_batch)
      866          s                      {
      867          s                          packC_ptr = packC_copy_copy + j * packC_ptr_step;
      868          s                          this->inner_kernel_for_corner(kc_adjust, packA_ptr, packB_ptr, packC_ptr, packC_col);
      869          s                          packB_ptr += step;
      870          s                      }
      871                             }
      872                             if (this->unpack_c != nullptr)
      873                                 this->unpack_c(mc_adjust, nc_adjust, nc_ceil, C_copy, packC_copy, ldc, row_batch, col_batch);
      874                         
      875                             // kernel_timer.accumBench();
      876                         }
      877                     }
      878                 }
      879                 // packA_timer.printBench("packA time", 1);
      880                 // packB_timer.printBench("packB time", 1);
      881                 // kernel_timer.printBench("kernel time", 1);
      882             
      883                 _mm_free(packA);
      884                 _mm_free(packB);
      885             }
      886             
      887             void ConvIm2colLayer::GEMM_v3(float* A, float* B, float* C) {
      888                 int lda = K;
      889                 int ldb = N;
      890                 int ldc = N;
      891             
      892    i            Timer packA_timer;
      893    i            Timer packB_timer;
      894    i            Timer kernel_timer;
      895             
      896                 float *packA = static_cast<float*>(_mm_malloc((mc * kc + 64) * sizeof(float), 256)); 
      897                 float *packB = static_cast<float*>(_mm_malloc((kc * (align_ceil(N, col_batch)) + 64) * sizeof(float), 256));
      898                 float *packC = C;
      899             
      900                 assert((mc % row_batch == 0) && (nc % col_batch == 0));
      901             
      902                 // A中的一大整列M * kc，B中的一大整行kc * N
      903                 for (int kt = 0; kt < K; kt += kc) {
      904                     int kc_adjust = min(kc, K - kt);
      905             
      906                     for (int mt = 0; mt < M; mt += mc) {
      907                         int mc_adjust = min(mc, M - mt);
      908                         // float *packA_copy = packA + mt * kc;
      909                         float *packA_copy = packA;
      910                         packA_timer.startBench();
      911                         // 对A的一块做packing
      912                         this->pack_a(mc_adjust, kc_adjust, A + mt*lda + kt, lda, packA_copy, mc, kc, nc, row_batch, col_batch);
      913                         packA_timer.accumBench();
      914                         
      915                         for (int nt = 0; nt < N; nt += nc) {
      916                             int nc_adjust = min(nc, N - nt);
      917                             int nc_ceil = align_ceil(nc_adjust, col_batch);
      918                             float *packB_copy = packB + nt * kc;
      919                             // mt为0时才需要做pack
      920                             if (mt == 0) {
      921                                 packB_timer.startBench();
      922                                 // 对B的一大块kc * nc做packing
      923                                 // this->pack_b(kc_adjust, nc_adjust, B + kt*ldb + nt, ldb, packB_copy, row_batch, col_batch);
      924                                 this->im2col_v1_fused_packB_Nx32(kc_adjust, nc_adjust, padding_input_data, packB_copy, kt, nt, row_batch, col_batch);
      925                                 packB_timer.accumBench();
      926                             }
      927             
      928                             // 接着就是计算，对A的一块mc * kc和B的一块kc * nc进行计算
      929                             float *C_copy = C + mt * ldc + nt;
      930             
      931                             int remain_row_start = mc_adjust - mc_adjust % row_batch;
      932                             int packB_step = col_batch * kc_adjust;
      933             
      934                             kernel_timer.startBench();
      935                             // 计算可以整除的行
      936                             int i = 0;
      937                             for (; i < remain_row_start; i += row_batch) {
      938                                 float *packA_ptr = packA_copy + i * kc_adjust;
      939                                 float *packB_ptr = packB_copy;
      940                                 float *packC_ptr_copy = C_copy + i * ldc;
      941                                 float *packC_ptr; 
      942                                 // 每次计算 col_batch 列。不足 col_batch 列的补0处理，因此也当成 col_batch 列进行计算
      943                                 for (int j = 0; j < nc_ceil; j += col_batch)
      944          s                      {
      945          s                          packC_ptr = packC_ptr_copy + j;
      946          s                          this->inner_kernel(kc_adjust, packA_ptr, packB_ptr, packC_ptr, ldc, prefetch_a, prefetch_b, this->prefetch_c);
      947          s                          packB_ptr += packB_step;
      948          s                      }
      949                             }
      950             
      951                             // 计算剩余的行
      952                             if (i < mc_adjust) {
      953                                 float *packA_ptr = packA_copy + i * kc_adjust;
      954                                 float *packB_ptr = packB_copy;
      955                                 float *packC_ptr_copy = C_copy + i * ldc;
      956                                 float *packC_ptr;
      957                                 //  每次计算 col_batch 列。不足 col_batch 列的补0处理，因此也当成 col_batch 列进行计算
                       <<< Loop-information Start >>>
                       <<<  [OPTIMIZATION]
                       <<<    SPILLS :
                       <<<      GENERAL   : SPILL 1  FILL 2
                       <<<      SIMD&FP   : SPILL 0  FILL 0
                       <<<      SCALABLE  : SPILL 0  FILL 0
                       <<<      PREDICATE : SPILL 0  FILL 0
                       <<< Loop-information  End >>>
      958                                 for (int j = 0; j < nc_ceil; j += col_batch)
      959          s                      {
      960          s                          packC_ptr = packC_ptr_copy + j;
      961          s                          this->inner_kernel_for_corner(kc_adjust, packA_ptr, packB_ptr, packC_ptr, ldc);
      962          s                          packB_ptr += packB_step;
      963          s                      }
      964                             }
      965                             kernel_timer.accumBench();
      966                         }
      967                     }
      968                 }
      969                 packA_timer.printBench("packA time", 1);
      970                 packB_timer.printBench("packB time", 1);
      971                 kernel_timer.printBench("kernel time", 1);
      972             
      973                 _mm_free(packA);
      974                 _mm_free(packB);
      975             }
      976             
      977             void ConvIm2colLayer::GEMM_v5_MNK(float* A, float* B, float* C) {
      978                 int lda = K;
      979                 int ldb = N;
      980                 int ldc = N;
      981             
      982                 // printf("gemm_v5\n");
      983             
      984    i            Timer packA_timer;
      985    i            Timer packB_timer;
      986    i            Timer kernel_timer;
      987             
      988                 float *packA = static_cast<float*>(_mm_malloc((mc * K + 16) * sizeof(float))); 
      989                 float *packB = static_cast<float*>(_mm_malloc((K * align_ceil(N, col_batch) + 16) * sizeof(float)));
      990                 float *packC = static_cast<float*>(_mm_malloc((mc * nc + 16) * sizeof(float)));
      991             
      992                 assert((mc % row_batch == 0) && (nc % col_batch == 0));
      993             
      994                 for (int mt = 0; mt < M; mt += mc) {
      995                     int mc_adjust = min(M - mt, mc);
      996             
      997                     for (int nt = 0; nt < N; nt += nc) {
      998                         int nc_adjust = min(N - nt, nc);
      999                         int nc_ceil   = align_ceil(nc_adjust, col_batch);
     1000             
     1001                         for (int kt = 0; kt < K; kt += kc) {
     1002                             int kc_adjust = min(K - kt, kc);
     1003                             float* packA_copy = packA + (kt/kc)*(mc*kc);
     1004                             float* packB_copy = packB + (nt/nc)*(K*nc) + (kt/kc)*(nc_ceil*kc);
     1005                             float* packC_copy = C + mt*ldc + nt;
     1006                             int packC_col = ldc;
     1007                             // float* packC_copy = packC;
     1008                             // int packC_col = nc;
     1009             
     1010                             
     1011                             if (mt == 0) {
     1012                                 packB_timer.startBench();
     1013                                 this->pack_b(kc_adjust, nc_adjust, B + kt*ldb + nt, ldb, packB_copy, row_batch, col_batch);
     1014                                 packB_timer.accumBench();
     1015                             }
     1016             
     1017                             if (nt == 0) {
     1018                                 packA_timer.startBench();
     1019                                 this->pack_a(mc_adjust, kc_adjust, A + mt*lda + kt, lda, packA_copy, mc, kc, nc, row_batch, col_batch);
     1020                                 packA_timer.accumBench();
     1021                             }
     1022             
     1023                             kernel_timer.startBench();
     1024                             int remain_row_start = mc_adjust - mc_adjust % row_batch;
     1025                             #pragma statement scache_isolate_way L1=1
     1026                             #pragma statement scache_isolate_assign packA_ptr
     1027                             for (int i = 0; i < remain_row_start; i += row_batch) {
     1028          s                      for (int j = 0; j < nc_ceil; j += col_batch) {
     1029          s                          float* packA_ptr = packA_copy + i * kc_adjust;
     1030          s                          float* packB_ptr = packB_copy + j * kc_adjust;
     1031          s                          float* packC_ptr = packC_copy + i * packC_col + j;
     1032          s                          this->inner_kernel(kc_adjust, packA_ptr, packB_ptr, packC_ptr, packC_col, this->prefetch_a, this->prefetch_b, this->prefetch_c);
     1033          s                      }
     1034                             }
     1035                             #pragma statement end_scache_isolate_assign
     1036                             #pragma statement end_scache_isolate_way
     1037             
     1038                             for (int i = remain_row_start; i < mc_adjust; i += row_batch) {
     1039          s                      for (int j = 0; j < nc_ceil; j += col_batch) {
     1040          s                          float* packA_ptr = packA_copy + i * kc_adjust;
     1041          s                          float* packB_ptr = packB_copy + j * kc_adjust;
     1042          s                          float* packC_ptr = packC_copy + i * packC_col + j;
     1043          s                          this->inner_kernel_for_corner(kc_adjust, packA_ptr, packB_ptr, packC_ptr, packC_col);
     1044          s                      }
     1045                             }
     1046                             kernel_timer.accumBench();
     1047             
     1048                         }
     1049             
     1050                         // 将结果写回到矩阵C中
     1051                         // for (int i = 0; i < mc_adjust; i++) {
     1052                         //     memcpy(C + (mt+i)*ldc + nt, packC + i*nc, nc_adjust * sizeof(float));
     1053                         // }
     1054                         // memset(packC, 0, mc * nc * sizeof(float));
     1055                     }
     1056             
     1057                 }
     1058             
     1059                 // printf("c[0] = %f, c[1] = %f, c[2] = %f\n", C[0], C[1], C[2]);
     1060             
     1061                 // packA_timer.printBench("packA time", 1);
     1062                 // packB_timer.printBench("packB time", 1);
     1063                 // kernel_timer.printBench("kernel time", 1);
     1064             
     1065                 _mm_free(packA);
     1066                 _mm_free(packB);
     1067                 _mm_free(packC);
     1068             }
     1069             
     1070             // 多线程版本
     1071             void ConvIm2colLayer::GEMM_multithread(float* A, float* B, float* C) {
     1072                 int lda = K;
     1073                 int ldb = N;
     1074                 int ldc = N;
     1075             
     1076                 int packB_width;
     1077                 int packB_height;
     1078                 int packBC_width;
     1079                 int packBC_height;
     1080             
     1081                 int num_threads = this->num_threads;
     1082                 
     1083                 packBC_height = kc + num_threads * mc;
     1084                 packBC_width = align_ceil(nc, col_batch);
     1085                 packB_height = kc;
     1086                 packB_width = packBC_width;
     1087             
     1088                 float *packA = new float[M * kc + 16 * num_threads];
     1089                 float *packB = new float[packBC_height * packBC_width + 16 * num_threads];
     1090                 // float *packA = _mm_malloc(M * kc * sizeof(float)); 
     1091                 // float *packB = _mm_malloc(packBC_height * packBC_width * sizeof(float));
     1092                 float *packC = packB + packB_height * packB_width;
     1093             
     1094                 // 确定每个线程所负责的A中分块
     1095                 int m_num_block = (M + (mc - 1)) / mc;
     1096                 int m_num_block_per_thread = m_num_block / num_threads;
     1097                 int m_num_remain_block = m_num_block % num_threads;
     1098                 #pragma omp parallel
     1099                 {
     1100                     int tid = omp_get_thread_num();
     1101                     int m_interval = m_num_block_per_thread * mc;
     1102                     int m_from;
     1103                     int m_to;
     1104                     if (tid < m_num_remain_block) {
     1105                         m_from = tid * (m_num_block_per_thread + 1) * mc;
     1106                         m_to = m_from + (m_num_block_per_thread + 1) * mc;
     1107                     }
     1108                     else{
     1109                         m_from = (tid * m_num_block_per_thread + m_num_remain_block) * mc;
     1110                         m_to = m_from + m_num_block_per_thread * mc;
     1111                     }
     1112                     if (m_to > M) 
     1113                         m_to = M;
     1114             
     1115                     if (m_to - m_from > 0) {
     1116                         m_interval = m_to - m_from;
     1117                         for (int kt = 0; kt < K; kt += kc) {
     1118                             int kc_adjust = min(kc, K - kt);
     1119             
     1120                             float *packA_copy = packA + m_from * kc;
     1121                             this->pack_a(m_interval, kc_adjust, A + m_from*lda + kt, lda, packA_copy, mc, kc, nc, row_batch, col_batch);
     1122                     
     1123                             for (int nt = 0; nt < N; nt += nc) {
     1124                                 int nc_adjust = min(nc, N - nt);
     1125                                 int nc_ceil = align_ceil(nc_adjust, col_batch);
     1126             
     1127                                 float *packB_copy = packB;
     1128                                 this->pack_b_mt(kc_adjust, nc_adjust, num_threads, tid, B, ldb, packB_copy, kt, nt, row_batch, col_batch);
     1129             
     1130                                 for (int mt = m_from; mt < m_to; mt += mc) {
     1131                                     int mc_adjust = min(mc, m_to - mt);
     1132                                     float *C_copy = C + mt * ldc + nt;
     1133                                     float *packC_copy;
     1134                                     int packC_ptr_step;
     1135                                     int packC_copy_step;
     1136                                     int packC_col;
     1137                                     
     1138                                     if (this->pack_c_version == 0) {
     1139                                         packC_ptr_step = 1;
     1140                                         packC_copy_step = ldc;
     1141                                         packC_copy = C_copy;
     1142                                         packC_col = ldc;
     1143                                     }
     1144                                     else if (this->pack_c_version == 1) {
     1145                                         packC_ptr_step = 1;
     1146                                         packC_copy_step = nc_ceil;
     1147                                         packC_copy = packC + tid * mc * packBC_width;
     1148                                         packC_col = nc_ceil;
     1149                                     }
     1150                                     else if (this->pack_c_version == 2) {
     1151                                         packC_ptr_step = mc_adjust;
     1152                                         packC_copy_step = col_batch;
     1153                                         packC_copy = packC + tid * mc * packBC_width;
     1154                                         packC_col = nc_ceil;
     1155                                     }
     1156             
     1157                                     if (this->pack_c != nullptr)
     1158                                         this->pack_c(mc_adjust, nc_adjust, nc_ceil, C_copy, packC_copy, ldc, row_batch, col_batch);
     1159             
     1160                                     int start_remain_row = mc_adjust - mc_adjust % row_batch;
     1161                                     int step = col_batch * kc_adjust;
     1162             
     1163                                     // 每次计算8行
     1164                                     for (int i = 0; i < start_remain_row; i += row_batch) {
     1165                                         float *packA_ptr = packA_copy + (mt - m_from + i) * kc_adjust;
     1166                                         float *packB_ptr = packB_copy;
     1167                                         float *packC_copy_copy = packC_copy + i * packC_copy_step;
     1168                                         float *packC_ptr;
     1169                                         // 每次计算8列。不足8列的补0处理，因此也当成8列进行计算
                       <<< Loop-information Start >>>
                       <<<  [OPTIMIZATION]
                       <<<    SPILLS :
                       <<<      GENERAL   : SPILL 0  FILL 2
                       <<<      SIMD&FP   : SPILL 0  FILL 0
                       <<<      SCALABLE  : SPILL 0  FILL 0
                       <<<      PREDICATE : SPILL 0  FILL 0
                       <<< Loop-information  End >>>
     1170          s                              for (int j = 0; j < nc_ceil; j += col_batch) {
     1171          s                                  packC_ptr = packC_copy_copy + j * packC_ptr_step;
     1172                                             // kernel_8x8(kc_adjust, packA_ptr, packB_ptr, packC_ptr, nc_ceil);
     1173          s                                  this->inner_kernel(kc_adjust, packA_ptr, packB_ptr, packC_ptr, packC_col, this->prefetch_a, this->prefetch_b, this->prefetch_c);
     1174          s                                  packB_ptr += step;
     1175          s                              }
     1176                                     
     1177                                     }
     1178             
     1179                                     // 不足8行，单独处理
     1180                                     int i = start_remain_row;
     1181                                     if (i < mc_adjust) {
     1182                                         float *packA_ptr = packA_copy + (mt - m_from + i) * kc_adjust;
     1183                                         float *packB_ptr = packB_copy;
     1184                                         float *packC_copy_copy = packC_copy + i * packC_copy_step;
     1185                                         float *packC_ptr;
     1186                                         int num_remain_row = mc_adjust - start_remain_row;
     1187                                         // 每次计算8列。不足8列的补0处理，因此也当成8列进行计算
                       <<< Loop-information Start >>>
                       <<<  [OPTIMIZATION]
                       <<<    SPILLS :
                       <<<      GENERAL   : SPILL 0  FILL 2
                       <<<      SIMD&FP   : SPILL 0  FILL 0
                       <<<      SCALABLE  : SPILL 0  FILL 0
                       <<<      PREDICATE : SPILL 0  FILL 0
                       <<< Loop-information  End >>>
     1188          s                              for (int j = 0; j < nc_ceil; j += col_batch) {
     1189          s                                  packC_ptr = packC_copy_copy + j * packC_ptr_step;
     1190                                             // kernel_Nx8_for_8x8_template(num_remain_row, kc_adjust, packA_ptr, packB_ptr, packC_ptr, nc_ceil);
     1191          s                                  this->inner_kernel_for_corner(kc_adjust, packA_ptr, packB_ptr, packC_ptr, packC_col);
     1192          s                                  packB_ptr += step;
     1193          s                              }
     1194                                     }
     1195                                     if (this->unpack_c != nullptr)
     1196                                         this->unpack_c(mc_adjust, nc_adjust, nc_ceil, C_copy, packC_copy, ldc, row_batch, col_batch);
     1197                                 }
     1198                             }
     1199                         }
     1200                     }
     1201                 }
     1202             
     1203                 delete [] packA;
     1204                 delete [] packB;
     1205                 // delete [] packC;
     1206             }
     1207             
