      332                 this->nc = best_nc;
      333                 this->kc = best_kc;
      334                 this->row_batch = best_rb;
      335                 this->col_batch = best_cb;
      336                 this->pack_c_version = best_pc;
      337                 this->mt_pack_b_version = best_pb;
      338                 this->prefetch_a = best_pre_a;
      339                 this->prefetch_b = best_pre_b;
      340                 this->prefetch_c = best_pre_c;
      341                 if (log_file != nullptr)
      342                 	fprintf(log_file, "%d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d\n", 
      343                             this->M, this->N, this->K, best_mc, best_nc, best_kc, best_rb, best_cb, 
      344                             this->gemm_version, best_pc, best_pb, best_pre_a, best_pre_b, best_pre_c);
      345                 else 
      346             	    printf("write best param error.\n");
      347                 fclose(log_file);
      348             }
