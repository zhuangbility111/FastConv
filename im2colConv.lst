                       <<<     SEQUENTIAL : 4
                       <<<      (unknown): 4
                       <<< Loop-information  End >>>
      676         2    					for (int j = j_begin; j <= j_end; j++) {
      677         2                        	*tmp = *in_ptr;
      678         2                        	tmp++;
      679         2                        	in_ptr++;
      680         2    					}
      681             
      682             //                 	in_ptr += (stride_height - 1) * padding_input_width - stride_width + kernel_width;
      683                              	in_ptr += padding_input_width - 1 + kernel_width;
      684             				}
      685             			}
      686             
      687                         // set (COL_BATCH - remain) elems to 0
                       <<< Loop-information Start >>>
                       <<<  [OPTIMIZATION]
                       <<<    SIMD(VL: 16)
                       <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 192, MVE: 2, POL: S)
