      316             
      317             enum nnp_convolution_algorithm select_algorithm(struct nnp_size kernel_size, struct nnp_size output_subsampling, struct nnp_size output_size) {
      318    i        	if (std::max(output_subsampling.height, output_subsampling.width) == 1) {
      319             		// Stride-1 convolution: consider fast convolution algorithm and direct 1x1
      320    i        		if (std::max(kernel_size.height, kernel_size.width) == 1) {
      321             			return nnp_convolution_algorithm_direct;
      322             		} else if (kernel_size.height == 3 && kernel_size.width == 3) {
      323             			return nnp_convolution_algorithm_winograd;
      324             		}
      325             	}
      326             
      327             	/* Fall-back algorithm */
      328             	return nnp_convolution_algorithm_im2col;
      329             
      330             }
