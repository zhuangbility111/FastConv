       72             void print_options_help(const char* program_name) {
       73             	printf(
       74                     "%s parameters...\n"
       75                     "Required parameters:\n"
       76                     "  -ic  --input-channels     The number of input channels\n"
       77                     "  -oc  --output-channels    The number of output channels\n"
       78                     "  -is  --input-size         Input height and width\n"
       79                     "  -ks  --kernel-size        Kernel height and width\n"
       80                     "Optional parameters:\n"
       81                     "  -a   --algorithm          The algorithm (auto, direct, im2col, or winograd) for computing convolution (default: auto)\n"
       82                     "  -ts  --transform-strategy The transformation strategy (online, or offline) for kernel transformation (default: online)\n"
       83                     "  -s   --output-subsampling The size of a output subsampling region, AKA stride (default: 1x1)\n"
       84                     "  -ip  --input-padding      Implicit input padding (default: 1)\n"
       85             		"  -tn  --tuning             whether to tuning (default: no_tuning)\n"
       86                     "  -t   --threads            The number of threads (default: 1)\n"
       87                     "  -i   --iterations         # iterations (default: 10)\n",
       88             	program_name);
       89             }
