       25             
       26             void* _mm_malloc(size_t sz, size_t align)
       27             {
       28                 void *ptr;
       29             #ifdef __APPLE__
       30                 return malloc(sz);
       31             #else
       32                 int alloc_result = posix_memalign(&ptr, align, sz);
       33                 if (alloc_result != 0)
       34                 {
       35                     return NULL;
       36                 }
       37                 return ptr;
       38             #endif
       39             }
       40             
       41             void _mm_free(void* ptr)
       42             {
       43                 if (NULL != ptr)
       44                 {
       45                     free(ptr);
       46                     ptr = NULL;
       47                 }
       48             }
       49             
       50             // 向上对齐
       51             int align_ceil(int num, int align)
       52             {
       53                 return num + (align - (num % align)) % align;
       54             }
