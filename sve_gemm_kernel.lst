      908                     "fmla	z21.s, p0/m, z4.s, z1.s                 \n"
      909                     
      910                     "fmla	z22.s, p0/m, z3.s, z2.s                 \n"
      911                     "fmla	z23.s, p0/m, z4.s, z2.s                 \n"
