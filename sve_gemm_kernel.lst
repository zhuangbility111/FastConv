      893                     "fmla	z15.s, p0/m, z4.s, z5.s                 \n"
      894                     
      895                     "fmla	z16.s, p0/m, z3.s, z6.s                 \n"
      896                     "fmla	z17.s, p0/m, z4.s, z6.s                 \n"
      897             
      898                     "ld1rw	{ z0.s }, p0/z, [%[pA], #20]            \n"
      899             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #24]            \n"
      900             	    "ld1rw	{ z2.s }, p0/z, [%[pA], #28]            \n"
      901             	    "ld1rw	{ z5.s }, p0/z, [%[pA], #32]            \n"
