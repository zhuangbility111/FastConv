      982                 : "memory", "cc", "p0", "x4", "z0", "z1", "z2", "z3", "z4", "z5", "z6", "z7", "z8", "z9",
      983                   "z10", "z11", "z12", "z13", "z14", "z15", "z16", "z17", "z18", "z19", "z20", "z21",
      984                   "z22", "z23", "z24", "z25", "z26", "z27", "z28", "z29", "z30", "z31");
      985             
      986             #else
      987             #endif
      988             }
      989             
      990             // new version, use broadcast and fmla and loop unroll by 2
      991             void kernel_12x32_v2(int kc_adjust, float *packA, float* packB, float *packC, int ldc, const int PREFETCH_A, const int PREFETCH_B, const int PREFETCH_C) {
      992             
      993                 float* packAPtr = packA;
      994                 float* packBPtr = packB;
      995                 float* packCPtr = packC;
      996             
      997             #ifdef _ASM_
      998             
      999                 float* packCPtr0  = packC;
     1000                 float* packCPtr1  = packC + 1  * ldc;
     1001                 float* packCPtr2  = packC + 2  * ldc;
     1002                 float* packCPtr3  = packC + 3  * ldc;
     1003                 float* packCPtr4  = packC + 4  * ldc;
     1004                 float* packCPtr5  = packC + 5  * ldc;
     1005                 float* packCPtr6  = packC + 6  * ldc;
     1006                 float* packCPtr7  = packC + 7  * ldc;
     1007                 float* packCPtr8  = packC + 8  * ldc;
     1008                 float* packCPtr9  = packC + 9  * ldc;
     1009                 float* packCPtr10 = packC + 10 * ldc;
     1010                 float* packCPtr11 = packC + 11 * ldc;
     1011             
     1012                 asm volatile(
     1013                     "ptrue  p0.s  \n"
     1014                     "mov    x4, #16 \n"
     1015                     "mov    x5, %[kc]    \n"
     1016                     "lsr    x6, x5, 0x1  \n"
     1017             		"mov    x7, #0 \n"
     1018             
     1019                     "cmp    w5, #0  \n"
     1020                     "b.eq    1f     \n"
     1021             
     1022             		//"add	%[pC0], %[pC0], 256*2 \n"
     1023             		//"prfm	pstl1keep, [%[pC0]] \n"
     1024             		//"sub	%[pC0], %[pC0], 256*2 \n"
     1025             
     1026                     "ld1w	{ z8.s },  p0/z, [%[pC0]]      \n"  // load C
     1027                     "ld1w	{ z9.s },  p0/z, [%[pC0], x4, lsl #2]    \n"
     1028                     "ld1w	{ z10.s }, p0/z, [%[pC1]]      \n"
     1029                     "ld1w	{ z11.s }, p0/z, [%[pC1], x4, lsl #2]    \n"
     1030                     "ld1w	{ z12.s }, p0/z, [%[pC2]]      \n"
     1031                     "ld1w	{ z13.s }, p0/z, [%[pC2], x4, lsl #2]    \n"
     1032                     "ld1w	{ z14.s }, p0/z, [%[pC3]]      \n"
     1033                     "ld1w	{ z15.s }, p0/z, [%[pC3], x4, lsl #2]    \n"
     1034                     "ld1w	{ z16.s }, p0/z, [%[pC4]]      \n"
     1035                     "ld1w	{ z17.s }, p0/z, [%[pC4], x4, lsl #2]    \n"
     1036                     "ld1w	{ z18.s }, p0/z, [%[pC5]]      \n"
     1037                     "ld1w	{ z19.s }, p0/z, [%[pC5], x4, lsl #2]    \n"
     1038                     "ld1w	{ z20.s }, p0/z, [%[pC6]]      \n"
     1039                     "ld1w	{ z21.s }, p0/z, [%[pC6], x4, lsl #2]    \n"
     1040                     "ld1w	{ z22.s }, p0/z, [%[pC7]]      \n"
     1041                     "ld1w	{ z23.s }, p0/z, [%[pC7], x4, lsl #2]    \n"
     1042                     "ld1w	{ z24.s }, p0/z, [%[pC8]]      \n"
     1043                     "ld1w	{ z25.s }, p0/z, [%[pC8], x4, lsl #2]    \n"
     1044                     "ld1w	{ z26.s }, p0/z, [%[pC9]]      \n"
     1045                     "ld1w	{ z27.s }, p0/z, [%[pC9], x4, lsl #2]    \n"
     1046                     "ld1w	{ z28.s }, p0/z, [%[pC10]]     \n"
     1047                     "ld1w	{ z29.s }, p0/z, [%[pC10], x4, lsl #2]    \n"
     1048                     "ld1w	{ z30.s }, p0/z, [%[pC11]]     \n"
     1049                     "ld1w	{ z31.s }, p0/z, [%[pC11], x4, lsl #2]    \n"
     1050             
     1051             
     1052                     "ld1w	{ z4.s }, p0/z, [%[pB]]                 \n"
     1053             	    "ld1w	{ z5.s }, p0/z, [%[pB], #1, MUL VL]     \n"
     1054             
     1055                     "prfm	pldl1keep, [%[pA],256*0]                \n"
     1056                     "prfm	pldl1keep, [%[pA],256*1]                \n"
     1057                     "prfm	pldl1keep, [%[pA],256*2]                \n"
     1058                     "prfm	pldl1keep, [%[pA],256*3]                \n"
     1059                     "prfm	pldl1keep, [%[pA],256*4]                \n"
     1060                     "prfm	pldl1keep, [%[pA],256*5]                \n"
     1061                     "prfm	pldl1keep, [%[pA],256*6]                \n"
     1062                     "prfm	pldl1keep, [%[pA],256*7]                \n"
     1063                     "prfm	pldl1keep, [%[pA],256*8]                \n"
     1064             
     1065                     "ld1rw	{ z0.s }, p0/z, [%[pA]]                 \n"
     1066             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #4]             \n"
     1067             
     1068                 "0:                                                 \n"
     1069             
     1070                     // ------------- loop 1 -------------
     1071             	    "ld1w	{ z6.s }, p0/z, [%[pB], #2, MUL VL]    \n"
     1072             	    "ld1w	{ z7.s }, p0/z, [%[pB], #3, MUL VL]    \n"
     1073             	
     1074             
     1075                     "fmla	z8.s,  p0/m, z4.s, z0.s                 \n"
     1076                     "fmla	z9.s,  p0/m, z5.s, z0.s                 \n"
     1077             
     1078                     "prfm	pldl1keep, [%[pA], 256*9]               \n"
     1079             	    "ld1rw	{ z2.s }, p0/z, [%[pA], #8]             \n"
     1080             	    "ld1rw	{ z3.s }, p0/z, [%[pA], #12]            \n"
     1081                     "fmla	z10.s, p0/m, z4.s, z1.s                 \n"
     1082                     "fmla	z11.s, p0/m, z5.s, z1.s                 \n"
     1083                     
     1084                     "ld1rw	{ z0.s }, p0/z, [%[pA], #16]            \n"
     1085             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #20]            \n"
     1086                     
     1087                     "fmla	z12.s, p0/m, z4.s, z2.s                 \n"
     1088                     "fmla	z13.s, p0/m, z5.s, z2.s                 \n"
     1089                     "fmla	z14.s, p0/m, z4.s, z3.s                 \n"
     1090                     "fmla	z15.s, p0/m, z5.s, z3.s                 \n"
     1091             
     1092             	    "ld1rw	{ z2.s }, p0/z, [%[pA], #24]            \n"
     1093             	    "ld1rw	{ z3.s }, p0/z, [%[pA], #28]            \n"
     1094                     
     1095                     "fmla	z16.s, p0/m, z4.s, z0.s                 \n"
     1096                     "fmla	z17.s, p0/m, z5.s, z0.s                 \n"
     1097                     "fmla	z18.s, p0/m, z4.s, z1.s                 \n"
     1098                     "fmla	z19.s, p0/m, z5.s, z1.s                 \n"
     1099             
     1100                     // "prfm	pldl1keep, [%[pA], 256*10]              \n"
     1101                     "ld1rw	{ z0.s }, p0/z, [%[pA], #32]            \n"
     1102             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #36]            \n"
     1103             
     1104                     "fmla	z20.s, p0/m, z4.s, z2.s                 \n"
     1105                     "fmla	z21.s, p0/m, z5.s, z2.s                 \n"
     1106                     "fmla	z22.s, p0/m, z4.s, z3.s                 \n"
     1107                     "fmla	z23.s, p0/m, z5.s, z3.s                 \n"
     1108             
     1109                     "ld1rw	{ z2.s }, p0/z, [%[pA], #40]            \n"
     1110             	    "ld1rw	{ z3.s }, p0/z, [%[pA], #44]            \n"
     1111             
     1112                     "add	%[pB], %[pB], #256                      \n"
     1113             
     1114                     "fmla	z24.s, p0/m, z4.s, z0.s                 \n"
     1115                     "fmla	z25.s, p0/m, z5.s, z0.s                 \n"
     1116                     "fmla	z26.s, p0/m, z4.s, z1.s                 \n"
     1117                     "fmla	z27.s, p0/m, z5.s, z1.s                 \n"
     1118             
     1119                     "ld1rw	{ z0.s }, p0/z, [%[pA], #48]            \n"
     1120             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #52]            \n" 
     1121             
     1122                     "fmla	z28.s, p0/m, z4.s, z2.s                 \n"
     1123                     "fmla	z29.s, p0/m, z5.s, z2.s                 \n"
     1124                     "fmla	z30.s, p0/m, z4.s, z3.s                 \n"
     1125                     "fmla	z31.s, p0/m, z5.s, z3.s                 \n"
     1126             
     1127                     // -------------- loop 2 -----------------
     1128                     "ld1w	{ z4.s },  p0/z, [%[pB]]                \n"
     1129             	    "ld1w	{ z5.s },  p0/z, [%[pB], #1, MUL VL]    \n"
     1130             
     1131                     "prfm	pldl1keep, [%[pA], #256*10]             \n"
     1132             	    "ld1rw	{ z2.s }, p0/z, [%[pA], #56]            \n"
     1133             	    "ld1rw	{ z3.s }, p0/z, [%[pA], #60]            \n"
     1134             
     1135                     "fmla	z8.s,  p0/m, z6.s, z0.s                 \n"
     1136                     "fmla	z9.s,  p0/m, z7.s, z0.s                 \n"
     1137                     "fmla	z10.s, p0/m, z6.s, z1.s                 \n"
     1138                     "fmla	z11.s, p0/m, z7.s, z1.s                 \n"
     1139             
     1140                     "ld1rw	{ z0.s }, p0/z, [%[pA], #64]            \n"
     1141             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #68]            \n"
     1142             
     1143                     "fmla	z12.s, p0/m, z6.s, z2.s                 \n"
     1144                     "fmla	z13.s, p0/m, z7.s, z2.s                 \n"
     1145                     "fmla	z14.s, p0/m, z6.s, z3.s                 \n"
     1146                     "fmla	z15.s, p0/m, z7.s, z3.s                 \n"
     1147             
     1148             	    "ld1rw	{ z2.s }, p0/z, [%[pA], #72]            \n"
     1149             	    "ld1rw	{ z3.s }, p0/z, [%[pA], #76]            \n"
     1150                     
     1151                     "fmla	z16.s, p0/m, z6.s, z0.s                 \n"
     1152                     "fmla	z17.s, p0/m, z7.s, z0.s                 \n"
     1153                     "fmla	z18.s, p0/m, z6.s, z1.s                 \n"
     1154                     "fmla	z19.s, p0/m, z7.s, z1.s                 \n"
     1155             
     1156                     // "prfm	pldl1keep, [%[pA], #1024]               \n"
     1157                     "ld1rw	{ z0.s }, p0/z, [%[pA], #80]            \n"
     1158             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #84]            \n"
     1159             
     1160                     "fmla	z20.s, p0/m, z6.s, z2.s                 \n"
     1161                     "fmla	z21.s, p0/m, z7.s, z2.s                 \n"
     1162                     "fmla	z22.s, p0/m, z6.s, z3.s                 \n"
     1163                     "fmla	z23.s, p0/m, z7.s, z3.s                 \n"
     1164             
     1165                     "ld1rw	{ z2.s }, p0/z, [%[pA], #88]            \n"
     1166             	    "ld1rw	{ z3.s }, p0/z, [%[pA], #92]            \n"
     1167             
     1168                     "add	%[pA], %[pA], #96                       \n"
     1169             
     1170                     "fmla	z24.s, p0/m, z6.s, z0.s                 \n"
     1171                     "fmla	z25.s, p0/m, z7.s, z0.s                 \n"
     1172                     "fmla	z26.s, p0/m, z6.s, z1.s                 \n"
     1173                     "fmla	z27.s, p0/m, z7.s, z1.s                 \n"
     1174             
     1175                     "ld1rw	{ z0.s }, p0/z, [%[pA]]                 \n"
     1176             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #4]             \n"
     1177             
     1178                     "fmla	z28.s, p0/m, z6.s, z2.s                 \n"
     1179                     "fmla	z29.s, p0/m, z7.s, z2.s                 \n"
     1180                     "fmla	z30.s, p0/m, z6.s, z3.s                 \n"
     1181                     "fmla	z31.s, p0/m, z7.s, z3.s                 \n"
     1182             
     1183                     "subs   x6, x6, #1                              \n"
     1184                     "b.ne   0b                                      \n"
     1185             
     1186                     
     1187                     "st1w	{ z8.s },  p0, [%[pC0]]      \n"  // store C
     1188                     "st1w	{ z9.s },  p0, [%[pC0], x4, lsl #2]    \n"
     1189                     "st1w	{ z10.s }, p0, [%[pC1]]      \n"
     1190                     "st1w	{ z11.s }, p0, [%[pC1], x4, lsl #2]    \n"
     1191                     "st1w	{ z12.s }, p0, [%[pC2]]      \n"
     1192                     "st1w	{ z13.s }, p0, [%[pC2], x4, lsl #2]    \n"
     1193                     "st1w	{ z14.s }, p0, [%[pC3]]      \n"
     1194                     "st1w	{ z15.s }, p0, [%[pC3], x4, lsl #2]    \n"
     1195                     "st1w	{ z16.s }, p0, [%[pC4]]      \n"
     1196                     "st1w	{ z17.s }, p0, [%[pC4], x4, lsl #2]    \n"
     1197                     "st1w	{ z18.s }, p0, [%[pC5]]      \n"
     1198                     "st1w	{ z19.s }, p0, [%[pC5], x4, lsl #2]    \n"
     1199                     "st1w	{ z20.s }, p0, [%[pC6]]      \n"
     1200                     "st1w	{ z21.s }, p0, [%[pC6], x4, lsl #2]    \n"
     1201                     "st1w	{ z22.s }, p0, [%[pC7]]      \n"
     1202                     "st1w	{ z23.s }, p0, [%[pC7], x4, lsl #2]    \n"
     1203                     "st1w	{ z24.s }, p0, [%[pC8]]      \n"
     1204                     "st1w	{ z25.s }, p0, [%[pC8], x4, lsl #2]    \n"
     1205                     "st1w	{ z26.s }, p0, [%[pC9]]      \n"
     1206                     "st1w	{ z27.s }, p0, [%[pC9], x4, lsl #2]    \n"
     1207                     "st1w	{ z28.s }, p0, [%[pC10]]     \n"
     1208                     "st1w	{ z29.s }, p0, [%[pC10], x4, lsl #2]    \n"
     1209                     "st1w	{ z30.s }, p0, [%[pC11]]     \n"
     1210                     "st1w	{ z31.s }, p0, [%[pC11], x4, lsl #2]    \n"
     1211             
     1212             
     1213                 "1:                                                 \n"
     1214                     
     1215                 : [pA]"=&r"(packAPtr),     // %0
     1216                   [pB]"=&r"(packBPtr)      // %1
     1217                 : "[pA]"   (packAPtr),
     1218                   "[pB]"   (packBPtr), 
     1219                   [pC0] "r"(packCPtr0),    // %2
     1220                   [pC1] "r"(packCPtr1),    // %2
     1221                   [pC2] "r"(packCPtr2),    // %3
     1222                   [pC3] "r"(packCPtr3),    // %3
     1223                   [pC4] "r"(packCPtr4),    // %4
     1224                   [pC5] "r"(packCPtr5),    // %4
     1225                   [pC6] "r"(packCPtr6),    // %5
     1226                   [pC7] "r"(packCPtr7),    // %5
     1227                   [pC8] "r"(packCPtr8),    // %6
     1228                   [pC9] "r"(packCPtr9),    // %6
     1229                   [pC10]"r"(packCPtr10),   // %7
     1230                   [pC11]"r"(packCPtr11),   // %7
     1231                   [ldc] "r"(ldc),
     1232                   [kc]  "r"(kc_adjust),
     1233                   [preA]"r"(PREFETCH_A),
     1234                   [preB]"r"(PREFETCH_B),
     1235                   [preC]"r"(PREFETCH_C)
     1236                 : "memory", "cc", "p0", "x4", "z0", "z1", "z2", "z3", "z4", "z5", "z6", "z7", "z8", "z9",
     1237                   "z10", "z11", "z12", "z13", "z14", "z15", "z16", "z17", "z18", "z19", "z20", "z21",
     1238                   "z22", "z23", "z24", "z25", "z26", "z27", "z28", "z29", "z30", "z31");
     1239             
     1240             #else
     1241                 float* packCPtr0  = packC;
     1242                 float* packCPtr1  = packC + 1  * ldc;
     1243                 float* packCPtr2  = packC + 2  * ldc;
     1244                 float* packCPtr3  = packC + 3  * ldc;
     1245                 float* packCPtr4  = packC + 4  * ldc;
     1246                 float* packCPtr5  = packC + 5  * ldc;
     1247                 float* packCPtr6  = packC + 6  * ldc;
     1248                 float* packCPtr7  = packC + 7  * ldc;
     1249                 float* packCPtr8  = packC + 8  * ldc;
     1250                 float* packCPtr9  = packC + 9  * ldc;
     1251                 float* packCPtr10 = packC + 10 * ldc;
     1252                 float* packCPtr11 = packC + 11 * ldc;
     1253             
     1254                 const svbool_t p32_all = svptrue_b32();
     1255             
     1256                 svfloat32_t va0,   va1, va2, va3;
     1257                 svfloat32_t vb4,   vb5, vb6, vb7;
     1258                 svfloat32_t vc00,  vc01;
     1259                 svfloat32_t vc10,  vc11;
     1260                 svfloat32_t vc20,  vc21;
     1261                 svfloat32_t vc30,  vc31;
     1262                 svfloat32_t vc40,  vc41;
     1263                 svfloat32_t vc50,  vc51;
     1264                 svfloat32_t vc60,  vc61;
     1265                 svfloat32_t vc70,  vc71;
     1266                 svfloat32_t vc80,  vc81;
     1267                 svfloat32_t vc90,  vc91;
     1268                 svfloat32_t vc100, vc101;
     1269                 svfloat32_t vc110, vc111;
     1270             
     1271                 vc00  = svld1_f32(p32_all, packCPtr0);
     1272                 vc01  = svld1_f32(p32_all, packCPtr0 + 16);
     1273                 vc10  = svld1_f32(p32_all, packCPtr1);
     1274                 vc11  = svld1_f32(p32_all, packCPtr1 + 16);
     1275                 vc20  = svld1_f32(p32_all, packCPtr2);
     1276                 vc21  = svld1_f32(p32_all, packCPtr2 + 16);
     1277                 vc30  = svld1_f32(p32_all, packCPtr3);
     1278                 vc31  = svld1_f32(p32_all, packCPtr3 + 16);
     1279                 vc40  = svld1_f32(p32_all, packCPtr4);
     1280                 vc41  = svld1_f32(p32_all, packCPtr4 + 16);
     1281                 vc50  = svld1_f32(p32_all, packCPtr5);
     1282                 vc51  = svld1_f32(p32_all, packCPtr5 + 16);
     1283                 vc60  = svld1_f32(p32_all, packCPtr6);
     1284                 vc61  = svld1_f32(p32_all, packCPtr6 + 16);
     1285                 vc70  = svld1_f32(p32_all, packCPtr7);
     1286                 vc71  = svld1_f32(p32_all, packCPtr7 + 16);
     1287                 vc80  = svld1_f32(p32_all, packCPtr8);
     1288                 vc81  = svld1_f32(p32_all, packCPtr8 + 16);
     1289                 vc90  = svld1_f32(p32_all, packCPtr9);
     1290                 vc91  = svld1_f32(p32_all, packCPtr9 + 16);
     1291                 vc100 = svld1_f32(p32_all, packCPtr10);
     1292                 vc101 = svld1_f32(p32_all, packCPtr10 + 16);
     1293                 vc110 = svld1_f32(p32_all, packCPtr11);
     1294                 vc111 = svld1_f32(p32_all, packCPtr11 + 16);
     1295             
     1296                 va0 = svdup_n_f32(packAPtr[0]);
     1297                 va1 = svdup_n_f32(packAPtr[1]);
     1298             
     1299                 vb4 = svld1_f32(p32_all, packBPtr);
     1300                 vb5 = svld1_f32(p32_all, packBPtr + 16);
     1301             
     1302                 // 计算
     1303                 for (int k = 0; k < kc_adjust; k += 2) {
     1304                     va2 = svdup_n_f32(packAPtr[2]);
     1305                     va3 = svdup_n_f32(packAPtr[3]);
     1306             
     1307                     vb6 = svld1_f32(p32_all, packBPtr + 32);
     1308                     vb7 = svld1_f32(p32_all, packBPtr + 48); 
     1309             
     1310                     vc00 = svmla_f32_x(p32_all, vc00, va0, vb4); 
     1311                     vc01 = svmla_f32_x(p32_all, vc01, va0, vb5); 
     1312                     vc10 = svmla_f32_x(p32_all, vc10, va1, vb4); 
     1313                     vc11 = svmla_f32_x(p32_all, vc11, va1, vb5); 
     1314             
     1315                     va0 = svdup_n_f32(packAPtr[4]);
     1316                     va1 = svdup_n_f32(packAPtr[5]);
     1317                     
     1318                     vc20 = svmla_f32_x(p32_all, vc20, va2, vb4); 
     1319                     vc21 = svmla_f32_x(p32_all, vc21, va2, vb5); 
     1320                     vc30 = svmla_f32_x(p32_all, vc30, va3, vb4); 
     1321                     vc31 = svmla_f32_x(p32_all, vc31, va3, vb5); 
     1322                     
     1323                     va2 = svdup_n_f32(packAPtr[6]);
     1324                     va3 = svdup_n_f32(packAPtr[7]);
     1325             
     1326                     vc40 = svmla_f32_x(p32_all, vc40, va0, vb4); 
     1327                     vc41 = svmla_f32_x(p32_all, vc41, va0, vb5); 
     1328                     vc50 = svmla_f32_x(p32_all, vc50, va1, vb4); 
     1329                     vc51 = svmla_f32_x(p32_all, vc51, va1, vb5); 
     1330             
     1331                     va0 = svdup_n_f32(packAPtr[8]);
     1332                     va1 = svdup_n_f32(packAPtr[9]);
     1333             
     1334                     vc60 = svmla_f32_x(p32_all, vc60, va2, vb4); 
     1335                     vc61 = svmla_f32_x(p32_all, vc61, va3, vb5); 
     1336                     vc70 = svmla_f32_x(p32_all, vc70, va2, vb4); 
     1337                     vc71 = svmla_f32_x(p32_all, vc71, va3, vb5); 
     1338             
     1339                     va2 = svdup_n_f32(packAPtr[10]);
     1340                     va3 = svdup_n_f32(packAPtr[11]);
     1341             
     1342                     packBPtr += 64;
     1343             
     1344                     vc80 = svmla_f32_x(p32_all, vc80, va0, vb4); 
     1345                     vc81 = svmla_f32_x(p32_all, vc81, va0, vb5); 
     1346                     vc90 = svmla_f32_x(p32_all, vc90, va1, vb4); 
     1347                     vc91 = svmla_f32_x(p32_all, vc91, va1, vb5); 
     1348             
     1349                     va0 = svdup_n_f32(packAPtr[12]);
     1350                     va1 = svdup_n_f32(packAPtr[13]);
     1351             
     1352                     vc100 = svmla_f32_x(p32_all, vc100, va2, vb4); 
     1353                     vc101 = svmla_f32_x(p32_all, vc101, va3, vb5); 
     1354                     vc110 = svmla_f32_x(p32_all, vc110, va2, vb4); 
     1355                     vc111 = svmla_f32_x(p32_all, vc111, va3, vb5);
     1356             
     1357                     // ----------loop 2--------------
     1358                     vb4 = svld1_f32(p32_all, packBPtr);
     1359                     vb5 = svld1_f32(p32_all, packBPtr + 16); 
     1360                     
     1361                     va2 = svdup_n_f32(packAPtr[14]);
     1362                     va3 = svdup_n_f32(packAPtr[15]);
     1363             
     1364                     vc00 = svmla_f32_x(p32_all, vc00, va0, vb6); 
     1365                     vc01 = svmla_f32_x(p32_all, vc01, va0, vb7); 
     1366                     vc10 = svmla_f32_x(p32_all, vc10, va1, vb6); 
     1367                     vc11 = svmla_f32_x(p32_all, vc11, va1, vb7); 
     1368             
     1369                     va0 = svdup_n_f32(packAPtr[16]);
     1370                     va1 = svdup_n_f32(packAPtr[17]);
     1371                     
     1372                     vc20 = svmla_f32_x(p32_all, vc20, va2, vb6); 
     1373                     vc21 = svmla_f32_x(p32_all, vc21, va2, vb7); 
     1374                     vc30 = svmla_f32_x(p32_all, vc30, va3, vb6); 
     1375                     vc31 = svmla_f32_x(p32_all, vc31, va3, vb7); 
     1376                     
     1377                     va2 = svdup_n_f32(packAPtr[18]);
     1378                     va3 = svdup_n_f32(packAPtr[19]);
     1379             
     1380                     vc40 = svmla_f32_x(p32_all, vc40, va0, vb6); 
     1381                     vc41 = svmla_f32_x(p32_all, vc41, va0, vb7); 
     1382                     vc50 = svmla_f32_x(p32_all, vc50, va1, vb6); 
     1383                     vc51 = svmla_f32_x(p32_all, vc51, va1, vb7); 
     1384             
     1385                     va0 = svdup_n_f32(packAPtr[20]);
     1386                     va1 = svdup_n_f32(packAPtr[21]);
     1387             
     1388                     vc60 = svmla_f32_x(p32_all, vc60, va2, vb6); 
     1389                     vc61 = svmla_f32_x(p32_all, vc61, va3, vb7); 
     1390                     vc70 = svmla_f32_x(p32_all, vc70, va2, vb6); 
     1391                     vc71 = svmla_f32_x(p32_all, vc71, va3, vb7); 
     1392             
     1393                     va2 = svdup_n_f32(packAPtr[22]);
     1394                     va3 = svdup_n_f32(packAPtr[23]);
     1395             
     1396                     vc80 = svmla_f32_x(p32_all, vc80, va0, vb6); 
     1397                     vc81 = svmla_f32_x(p32_all, vc81, va0, vb7); 
     1398                     vc90 = svmla_f32_x(p32_all, vc90, va1, vb6); 
     1399                     vc91 = svmla_f32_x(p32_all, vc91, va1, vb7); 
     1400             
     1401                     packAPtr += 24;
     1402             
     1403                     va0 = svdup_n_f32(packAPtr[0]);
     1404                     va1 = svdup_n_f32(packAPtr[1]);
     1405             
     1406                     vc100 = svmla_f32_x(p32_all, vc100, va2, vb6); 
     1407                     vc101 = svmla_f32_x(p32_all, vc101, va3, vb7); 
     1408                     vc110 = svmla_f32_x(p32_all, vc110, va2, vb6); 
     1409                     vc111 = svmla_f32_x(p32_all, vc111, va3, vb7);
     1410             
     1411                 }
     1412             
     1413                 // 将结果写回
     1414                 svst1_f32(p32_all, packCPtr0, vc00);
     1415                 svst1_f32(p32_all, packCPtr0 + 16, vc01);
     1416                 svst1_f32(p32_all, packCPtr1, vc10);
     1417                 svst1_f32(p32_all, packCPtr1 + 16, vc11);
     1418                 svst1_f32(p32_all, packCPtr2, vc20);
     1419                 svst1_f32(p32_all, packCPtr2 + 16, vc21);
     1420                 svst1_f32(p32_all, packCPtr3, vc30);
     1421                 svst1_f32(p32_all, packCPtr3 + 16, vc31);
     1422                 svst1_f32(p32_all, packCPtr4, vc40);
     1423                 svst1_f32(p32_all, packCPtr4 + 16, vc41);
     1424                 svst1_f32(p32_all, packCPtr5, vc50);
     1425                 svst1_f32(p32_all, packCPtr5 + 16, vc51);
     1426                 svst1_f32(p32_all, packCPtr6, vc60);
     1427                 svst1_f32(p32_all, packCPtr6 + 16, vc61);
     1428                 svst1_f32(p32_all, packCPtr7, vc70);
     1429                 svst1_f32(p32_all, packCPtr7 + 16, vc71);
     1430                 svst1_f32(p32_all, packCPtr8, vc80);
     1431                 svst1_f32(p32_all, packCPtr8 + 16, vc81);
     1432                 svst1_f32(p32_all, packCPtr9, vc90);
     1433                 svst1_f32(p32_all, packCPtr9 + 16, vc91);
     1434                 svst1_f32(p32_all, packCPtr10, vc100);
     1435                 svst1_f32(p32_all, packCPtr10 + 16, vc101);
     1436                 svst1_f32(p32_all, packCPtr11, vc110);
     1437                 svst1_f32(p32_all, packCPtr11 + 16, vc111);
     1438             
     1439             
     1440             #endif
     1441             }
     1442             
     1443             // new version, use broadcast and fmla and loop unroll by 2
     1444             void kernel_8x32_v1(int kc_adjust, float *packA, float* packB, float *packC, int ldc, const int PREFETCH_A, const int PREFETCH_B, const int PREFETCH_C) {
     1445             
     1446                 float* packAPtr = packA;
     1447                 float* packBPtr = packB;
     1448                 float* packCPtr = packC;
     1449             
     1450             #ifdef _ASM_
     1451             
     1452                 float* packCPtr0  = packC;
     1453                 float* packCPtr1  = packC + 1  * ldc;
     1454                 float* packCPtr2  = packC + 2  * ldc;
     1455                 float* packCPtr3  = packC + 3  * ldc;
     1456                 float* packCPtr4  = packC + 4  * ldc;
     1457                 float* packCPtr5  = packC + 5  * ldc;
     1458                 float* packCPtr6  = packC + 6  * ldc;
     1459                 float* packCPtr7  = packC + 7  * ldc;
     1460             
     1461                 asm volatile(
     1462                     "ptrue  p0.s  \n"
     1463                     "mov    x4, #16 \n"
     1464                     "mov    x5, %[kc]    \n"
     1465                     "lsr    x6, x5, 0x1  \n"
     1466             
     1467                     "cmp    w5, #0  \n"
     1468                     "b.eq    1f     \n"
     1469             
     1470                     
     1471                     "ld1w	{ z16.s }, p0/z, [%[pC0]]      \n"
     1472                     "ld1w	{ z17.s }, p0/z, [%[pC0], x4, lsl #2]    \n"
     1473                     "ld1w	{ z18.s }, p0/z, [%[pC1]]      \n"
     1474                     "ld1w	{ z19.s }, p0/z, [%[pC1], x4, lsl #2]    \n"
     1475                     "ld1w	{ z20.s }, p0/z, [%[pC2]]      \n"
     1476                     "ld1w	{ z21.s }, p0/z, [%[pC2], x4, lsl #2]    \n"
     1477                     "ld1w	{ z22.s }, p0/z, [%[pC3]]      \n"
     1478                     "ld1w	{ z23.s }, p0/z, [%[pC3], x4, lsl #2]    \n"
     1479                     "ld1w	{ z24.s }, p0/z, [%[pC4]]      \n"
     1480                     "ld1w	{ z25.s }, p0/z, [%[pC4], x4, lsl #2]    \n"
     1481                     "ld1w	{ z26.s }, p0/z, [%[pC5]]      \n"
     1482                     "ld1w	{ z27.s }, p0/z, [%[pC5], x4, lsl #2]    \n"
     1483                     "ld1w	{ z28.s }, p0/z, [%[pC6]]     \n"
     1484                     "ld1w	{ z29.s }, p0/z, [%[pC6], x4, lsl #2]    \n"
     1485                     "ld1w	{ z30.s }, p0/z, [%[pC7]]     \n"
     1486                     "ld1w	{ z31.s }, p0/z, [%[pC7], x4, lsl #2]    \n"
     1487             
     1488             
     1489                     "ld1w	{ z12.s }, p0/z, [%[pB]]                 \n"
     1490             	    "ld1w	{ z13.s }, p0/z, [%[pB], #1, MUL VL]     \n"
     1491             
     1492                     "ld1rw	{ z0.s }, p0/z, [%[pA]]                 \n"
     1493             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #4]             \n"
     1494             	    "ld1rw	{ z2.s }, p0/z, [%[pA], #8]             \n"
     1495             	    "ld1rw	{ z3.s }, p0/z, [%[pA], #12]            \n"
     1496                     "ld1rw	{ z4.s }, p0/z, [%[pA], #16]            \n"
     1497             	    "ld1rw	{ z5.s }, p0/z, [%[pA], #20]            \n"
     1498             	    "ld1rw	{ z6.s }, p0/z, [%[pA], #24]            \n"
     1499             	    "ld1rw	{ z7.s }, p0/z, [%[pA], #28]            \n"
     1500             
     1501                 "0:                                                 \n"
     1502                     // ------------- loop 1 -------------
     1503             	    "ld1w	{ z14.s }, p0/z, [%[pB], #2, MUL VL]    \n"
     1504             	    "ld1w	{ z15.s }, p0/z, [%[pB], #3, MUL VL]    \n"
     1505             
     1506                     "prfm	pldl1keep, [%[pA], #256]                \n"
     1507             
     1508                     "fmla	z16.s, p0/m, z12.s, z0.s                 \n"
     1509                     "fmla	z17.s, p0/m, z13.s, z0.s                 \n"
     1510                     "fmla	z18.s, p0/m, z12.s, z1.s                 \n"
     1511                     "fmla	z19.s, p0/m, z13.s, z1.s                 \n" 
     1512                     
     1513                     "fmla	z20.s, p0/m, z12.s, z2.s                 \n"
     1514                     "fmla	z21.s, p0/m, z13.s, z2.s                 \n"
     1515                     "fmla	z22.s, p0/m, z12.s, z3.s                 \n"
     1516                     "fmla	z23.s, p0/m, z13.s, z3.s                 \n"
     1517             
     1518                     "ld1rw	{ z0.s }, p0/z, [%[pA], #32]            \n"
     1519             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #36]            \n"
     1520             	    "ld1rw	{ z2.s }, p0/z, [%[pA], #40]            \n"
     1521             	    "ld1rw	{ z3.s }, p0/z, [%[pA], #44]            \n"
     1522                     "ld1rw	{ z8.s },  p0/z, [%[pA], #48]            \n"
     1523             	    "ld1rw	{ z9.s },  p0/z, [%[pA], #52]            \n"
     1524                     "ld1rw	{ z10.s }, p0/z, [%[pA], #56]            \n"
     1525             	    "ld1rw	{ z11.s }, p0/z, [%[pA], #60]            \n"
     1526             
     1527                     "fmla	z24.s, p0/m, z12.s, z4.s                 \n"
     1528                     "fmla	z25.s, p0/m, z13.s, z4.s                 \n"
     1529                     "fmla	z26.s, p0/m, z12.s, z5.s                 \n"
     1530                     "fmla	z27.s, p0/m, z13.s, z5.s                 \n"
     1531             
     1532                     "add	%[pB], %[pB], #256                      \n"
     1533             
     1534                     "fmla	z28.s, p0/m, z12.s, z6.s                 \n"
     1535                     "fmla	z29.s, p0/m, z13.s, z6.s                 \n"
     1536                     "fmla	z30.s, p0/m, z12.s, z7.s                 \n"
     1537                     "fmla	z31.s, p0/m, z13.s, z7.s                 \n"
     1538             
     1539                     // -------------- loop 2 -----------------
     1540                     "ld1w	{ z12.s },  p0/z, [%[pB]]                \n"
     1541             	    "ld1w	{ z13.s },  p0/z, [%[pB], #1, MUL VL]    \n"
     1542             
     1543                     "prfm	pldl1keep, [%[pA], #512]                \n"
     1544             
     1545                     "fmla	z16.s, p0/m, z14.s, z0.s                 \n"
     1546                     "fmla	z17.s, p0/m, z15.s, z0.s                 \n"
     1547                     "fmla	z18.s, p0/m, z14.s, z1.s                 \n"
     1548                     "fmla	z19.s, p0/m, z15.s, z1.s                 \n"
     1549             
     1550                     "add	%[pA], %[pA], #64                       \n"
     1551                     
     1552                     "fmla	z20.s, p0/m, z14.s, z2.s                 \n"
     1553                     "fmla	z21.s, p0/m, z15.s, z2.s                 \n"
     1554                     "fmla	z22.s, p0/m, z14.s, z3.s                 \n"
     1555                     "fmla	z23.s, p0/m, z15.s, z3.s                 \n"
     1556             
     1557                     "ld1rw	{ z0.s }, p0/z, [%[pA]]                 \n"
     1558             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #4]             \n"
     1559             	    "ld1rw	{ z2.s }, p0/z, [%[pA], #8]             \n"
     1560             	    "ld1rw	{ z3.s }, p0/z, [%[pA], #12]            \n"
     1561                     "ld1rw	{ z4.s }, p0/z, [%[pA], #16]            \n"
     1562             	    "ld1rw	{ z5.s }, p0/z, [%[pA], #20]            \n"
     1563             	    "ld1rw	{ z6.s }, p0/z, [%[pA], #24]            \n"
     1564             	    "ld1rw	{ z7.s }, p0/z, [%[pA], #28]            \n"
     1565             
     1566                     "fmla	z24.s, p0/m, z14.s, z8.s                 \n"
     1567                     "fmla	z25.s, p0/m, z15.s, z8.s                 \n"
     1568                     "fmla	z26.s, p0/m, z14.s, z9.s                 \n"
     1569                     "fmla	z27.s, p0/m, z15.s, z9.s                 \n"
     1570             
     1571                     "fmla	z28.s, p0/m, z14.s, z10.s                \n"
     1572                     "fmla	z29.s, p0/m, z15.s, z10.s                \n"
     1573                     "fmla	z30.s, p0/m, z14.s, z11.s                \n"
     1574                     "fmla	z31.s, p0/m, z15.s, z11.s                \n"
     1575             
     1576                     "subs   x6, x6, #1                              \n"
     1577                     "b.ne   0b                                      \n"
     1578             
     1579                     "st1w	{ z16.s }, p0, [%[pC0]]      \n"
     1580                     "st1w	{ z17.s }, p0, [%[pC0], x4, lsl #2]    \n"
     1581                     "st1w	{ z18.s }, p0, [%[pC1]]      \n"
     1582                     "st1w	{ z19.s }, p0, [%[pC1], x4, lsl #2]    \n"
     1583                     "st1w	{ z20.s }, p0, [%[pC2]]      \n"
     1584                     "st1w	{ z21.s }, p0, [%[pC2], x4, lsl #2]    \n"
     1585                     "st1w	{ z22.s }, p0, [%[pC3]]      \n"
     1586                     "st1w	{ z23.s }, p0, [%[pC3], x4, lsl #2]    \n"
     1587                     "st1w	{ z24.s }, p0, [%[pC4]]      \n"
     1588                     "st1w	{ z25.s }, p0, [%[pC4], x4, lsl #2]    \n"
     1589                     "st1w	{ z26.s }, p0, [%[pC5]]      \n"
     1590                     "st1w	{ z27.s }, p0, [%[pC5], x4, lsl #2]    \n"
     1591                     "st1w	{ z28.s }, p0, [%[pC6]]     \n"
     1592                     "st1w	{ z29.s }, p0, [%[pC6], x4, lsl #2]    \n"
     1593                     "st1w	{ z30.s }, p0, [%[pC7]]     \n"
     1594                     "st1w	{ z31.s }, p0, [%[pC7], x4, lsl #2]    \n"
     1595             
     1596             
     1597                 "1:                                                 \n"
     1598                     
     1599                 : [pA]"=&r"(packAPtr),     // %0
     1600                   [pB]"=&r"(packBPtr)      // %1
     1601                 : "[pA]"   (packAPtr),
     1602                   "[pB]"   (packBPtr), 
     1603                   [pC0] "r"(packCPtr0),    // %2
     1604                   [pC1] "r"(packCPtr1),    // %2
     1605                   [pC2] "r"(packCPtr2),    // %3
     1606                   [pC3] "r"(packCPtr3),    // %3
     1607                   [pC4] "r"(packCPtr4),    // %4
     1608                   [pC5] "r"(packCPtr5),    // %4
     1609                   [pC6] "r"(packCPtr6),    // %5
     1610                   [pC7] "r"(packCPtr7),    // %5
     1611                   [ldc] "r"(ldc),
     1612                   [kc]  "r"(kc_adjust),
     1613                   [preA]"r"(PREFETCH_A),
     1614                   [preB]"r"(PREFETCH_B),
     1615                   [preC]"r"(PREFETCH_C)
     1616                 : "memory", "cc", "p0", "x4", "z0", "z1", "z2", "z3", "z4", "z5", "z6", "z7", "z8", "z9",
     1617                   "z10", "z11", "z12", "z13", "z14", "z15", "z16", "z17", "z18", "z19", "z20", "z21",
     1618                   "z22", "z23", "z24", "z25", "z26", "z27", "z28", "z29", "z30", "z31");
     1619             #endif
     1620             }
     1621             
     1622             
     1623             
     1624             // new version, use broadcast and fmla
     1625             void kernel_14x32(int kc_adjust, float *packA, float* packB, float *packC, int ldc, const int PREFETCH_A, const int PREFETCH_B, const int PREFETCH_C) {
     1626             
     1627                 float* packAPtr = packA;
     1628                 float* packBPtr = packB;
     1629                 float* packCPtr = packC;
     1630             
     1631             #ifdef _ASM_
     1632             
     1633                 float* packCPtr0  = packC;
     1634                 float* packCPtr1  = packC + 1  * ldc;
     1635                 float* packCPtr2  = packC + 2  * ldc;
