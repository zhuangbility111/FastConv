      318                     vc71 = svmla_f32_x(p32_all, vc71, va7, vb1);
      319             
      320                     packAPtr += 8;
      321                     packBPtr += 32;
      322                 }
      323             	#pragma statement end_scache_isolate_assign
      324             	#pragma statement end_scache_isolate_way       
      325             
      326                 // 将结果写回
      327                 svst1_f32(p32_all, packCPtr0, vc00);
      328                 svst1_f32(p32_all, packCPtr0 + 16, vc01);
      329                 svst1_f32(p32_all, packCPtr1, vc10);
      330                 svst1_f32(p32_all, packCPtr1 + 16, vc11);
      331                 svst1_f32(p32_all, packCPtr2, vc20);
      332                 svst1_f32(p32_all, packCPtr2 + 16, vc21);
      333                 svst1_f32(p32_all, packCPtr3, vc30);
      334                 svst1_f32(p32_all, packCPtr3 + 16, vc31);
      335                 svst1_f32(p32_all, packCPtr4, vc40);
      336                 svst1_f32(p32_all, packCPtr4 + 16, vc41);
      337                 svst1_f32(p32_all, packCPtr5, vc50);
      338                 svst1_f32(p32_all, packCPtr5 + 16, vc51);
      339                 svst1_f32(p32_all, packCPtr6, vc60);
      340                 svst1_f32(p32_all, packCPtr6 + 16, vc61);
      341                 svst1_f32(p32_all, packCPtr7, vc70);
      342                 svst1_f32(p32_all, packCPtr7 + 16, vc71);
      343             
      344             #endif
      345             }
      346             
      347             // old version, use indexed fmla
      348             void kernel_12x32(int kc_adjust, float *packA, float* packB, float *packC, int ldc, const int PREFETCH_A, const int PREFETCH_B, const int PREFETCH_C) {
      349             
      350                 float* packAPtr = packA;
      351                 float* packBPtr = packB;
      352                 float* packCPtr = packC;
      353             
      354             #ifdef _ASM_
      355             
      356                 float* packCPtr0  = packC;
      357                 float* packCPtr1  = packC + 1  * ldc;
      358                 float* packCPtr2  = packC + 2  * ldc;
      359                 float* packCPtr3  = packC + 3  * ldc;
      360                 float* packCPtr4  = packC + 4  * ldc;
      361                 float* packCPtr5  = packC + 5  * ldc;
      362                 float* packCPtr6  = packC + 6  * ldc;
      363                 float* packCPtr7  = packC + 7  * ldc;
      364                 float* packCPtr8  = packC + 8  * ldc;
      365                 float* packCPtr9  = packC + 9  * ldc;
      366                 float* packCPtr10 = packC + 10 * ldc;
      367                 float* packCPtr11 = packC + 11 * ldc;
      368             
      369                 asm volatile(
      370                     "ptrue  p0.s  \n"
      371                     "mov    x4, #16 \n"
      372                     "mov    x5, %[kc]    \n"
      373             
      374                     "cmp    w5, #0  \n"
      375                     "b.eq    1f     \n"
      376             
      377                     "ld1w	{ z8.s },  p0/z, [%[pC0]]      \n"  // load C
      378                     "ld1w	{ z9.s },  p0/z, [%[pC0], x4, lsl #2]    \n"
      379                     "ld1w	{ z10.s }, p0/z, [%[pC1]]      \n"
      380                     "ld1w	{ z11.s }, p0/z, [%[pC1], x4, lsl #2]    \n"
      381                     "ld1w	{ z12.s }, p0/z, [%[pC2]]      \n"
      382                     "ld1w	{ z13.s }, p0/z, [%[pC2], x4, lsl #2]    \n"
      383                     "ld1w	{ z14.s }, p0/z, [%[pC3]]      \n"
      384                     "ld1w	{ z15.s }, p0/z, [%[pC3], x4, lsl #2]    \n"
      385                     "ld1w	{ z16.s }, p0/z, [%[pC4]]      \n"
      386                     "ld1w	{ z17.s }, p0/z, [%[pC4], x4, lsl #2]    \n"
      387                     "ld1w	{ z18.s }, p0/z, [%[pC5]]      \n"
      388                     "ld1w	{ z19.s }, p0/z, [%[pC5], x4, lsl #2]    \n"
      389                     "ld1w	{ z20.s }, p0/z, [%[pC6]]      \n"
      390                     "ld1w	{ z21.s }, p0/z, [%[pC6], x4, lsl #2]    \n"
      391                     "ld1w	{ z22.s }, p0/z, [%[pC7]]      \n"
      392                     "ld1w	{ z23.s }, p0/z, [%[pC7], x4, lsl #2]    \n"
      393                     "ld1w	{ z24.s }, p0/z, [%[pC8]]      \n"
      394                     "ld1w	{ z25.s }, p0/z, [%[pC8], x4, lsl #2]    \n"
      395                     "ld1w	{ z26.s }, p0/z, [%[pC9]]      \n"
      396                     "ld1w	{ z27.s }, p0/z, [%[pC9], x4, lsl #2]    \n"
      397                     "ld1w	{ z28.s }, p0/z, [%[pC10]]     \n"
      398                     "ld1w	{ z29.s }, p0/z, [%[pC10], x4, lsl #2]    \n"
      399                     "ld1w	{ z30.s }, p0/z, [%[pC11]]     \n"
      400                     "ld1w	{ z31.s }, p0/z, [%[pC11], x4, lsl #2]    \n"
      401             
      402                 "0:                                                 \n"
      403             
      404             	    "ld1rqw	{ z0.s }, p0/z, [%[pA]]                 \n"
      405             	    "ld1rqw	{ z1.s }, p0/z, [%[pA], #16]            \n"
      406             	    "ld1rqw	{ z2.s }, p0/z, [%[pA], #32]            \n"
      407             //        "prfm	pldl1keep, [%[pA], #128]                \n"
      408             	    
      409                     "ld1w	{ z3.s }, p0/z, [%[pB]]                 \n"
      410             	    "ld1w	{ z4.s }, p0/z, [%[pB], x4, lsl #2]     \n"
      411             //        "prfm	pldl1keep, [%[pB], #128]                \n"
      412                     "add	%[pA], %[pA], #48                       \n"
      413             
      414                     "fmla	z8.s,  z3.s, z0.s[0]                    \n"
      415                     "fmla	z10.s, z3.s, z0.s[1]                    \n"
      416                     "fmla	z12.s, z3.s, z0.s[2]                    \n"
      417                     "fmla	z14.s, z3.s, z0.s[3]                    \n"
      418             
      419                     "fmla	z9.s,  z4.s, z0.s[0]                    \n"
      420                     "fmla	z11.s, z4.s, z0.s[1]                    \n"
      421                     "fmla	z13.s, z4.s, z0.s[2]                    \n"
      422                     "fmla	z15.s, z4.s, z0.s[3]                    \n"
      423                     "add	%[pB], %[pB], #128                      \n"
      424                     // "prfm	pldl1keep, [%[pA], #128]                 \n"
      425             
      426                     "fmla	z16.s, z3.s, z1.s[0]                    \n"
      427                     "fmla	z18.s, z3.s, z1.s[1]                    \n"
      428                     "fmla	z20.s, z3.s, z1.s[2]                    \n"
      429                     "fmla	z22.s, z3.s, z1.s[3]                    \n"
      430             
      431                     "fmla	z17.s, z4.s, z1.s[0]                    \n"
      432                     "fmla	z19.s, z4.s, z1.s[1]                    \n"
      433                     "fmla	z21.s, z4.s, z1.s[2]                    \n"
      434                     "fmla	z23.s, z4.s, z1.s[3]                    \n"
      435                     "subs   x5, x5, #1                              \n"
      436             //        "prfm	pldl1keep, [%[pA]]                      \n"
      437             
      438                     "fmla	z24.s, z3.s, z2.s[0]                    \n"
      439                     "fmla	z26.s, z3.s, z2.s[1]                    \n"
      440                     "fmla	z28.s, z3.s, z2.s[2]                    \n"
      441                     "fmla	z30.s, z3.s, z2.s[3]                    \n"
      442             
      443                     "fmla	z25.s, z4.s, z2.s[0]                    \n"
      444                     "fmla	z27.s, z4.s, z2.s[1]                    \n"
      445                     "fmla	z29.s, z4.s, z2.s[2]                    \n"
      446                     "fmla	z31.s, z4.s, z2.s[3]                    \n"
      447             
      448             
      449                     "b.ne   0b                                      \n"
      450                     
      451                     "st1w	{ z8.s },  p0, [%[pC0]]      \n"  // store C
      452                     "st1w	{ z9.s },  p0, [%[pC0], x4, lsl #2]    \n"
      453                     "st1w	{ z10.s }, p0, [%[pC1]]      \n"
      454                     "st1w	{ z11.s }, p0, [%[pC1], x4, lsl #2]    \n"
      455                     "st1w	{ z12.s }, p0, [%[pC2]]      \n"
      456                     "st1w	{ z13.s }, p0, [%[pC2], x4, lsl #2]    \n"
      457                     "st1w	{ z14.s }, p0, [%[pC3]]      \n"
      458                     "st1w	{ z15.s }, p0, [%[pC3], x4, lsl #2]    \n"
      459                     "st1w	{ z16.s }, p0, [%[pC4]]      \n"
      460                     "st1w	{ z17.s }, p0, [%[pC4], x4, lsl #2]    \n"
      461                     "st1w	{ z18.s }, p0, [%[pC5]]      \n"
      462                     "st1w	{ z19.s }, p0, [%[pC5], x4, lsl #2]    \n"
      463                     "st1w	{ z20.s }, p0, [%[pC6]]      \n"
      464                     "st1w	{ z21.s }, p0, [%[pC6], x4, lsl #2]    \n"
      465                     "st1w	{ z22.s }, p0, [%[pC7]]      \n"
      466                     "st1w	{ z23.s }, p0, [%[pC7], x4, lsl #2]    \n"
      467                     "st1w	{ z24.s }, p0, [%[pC8]]      \n"
      468                     "st1w	{ z25.s }, p0, [%[pC8], x4, lsl #2]    \n"
      469                     "st1w	{ z26.s }, p0, [%[pC9]]      \n"
      470                     "st1w	{ z27.s }, p0, [%[pC9], x4, lsl #2]    \n"
      471                     "st1w	{ z28.s }, p0, [%[pC10]]     \n"
      472                     "st1w	{ z29.s }, p0, [%[pC10], x4, lsl #2]    \n"
      473                     "st1w	{ z30.s }, p0, [%[pC11]]     \n"
      474                     "st1w	{ z31.s }, p0, [%[pC11], x4, lsl #2]    \n"
      475             
      476                 "1:                                                 \n"
      477                     
      478                 : [pA]"=&r"(packAPtr),     // %0
      479                   [pB]"=&r"(packBPtr)      // %1
      480                 : "[pA]"   (packAPtr),
      481                   "[pB]"   (packBPtr), 
      482                   [pC0] "r"(packCPtr0),    // %2
      483                   [pC1] "r"(packCPtr1),    // %2
      484                   [pC2] "r"(packCPtr2),    // %3
      485                   [pC3] "r"(packCPtr3),    // %3
      486                   [pC4] "r"(packCPtr4),    // %4
      487                   [pC5] "r"(packCPtr5),    // %4
      488                   [pC6] "r"(packCPtr6),    // %5
      489                   [pC7] "r"(packCPtr7),    // %5
      490                   [pC8] "r"(packCPtr8),    // %6
      491                   [pC9] "r"(packCPtr9),    // %6
      492                   [pC10]"r"(packCPtr10),   // %7
      493                   [pC11]"r"(packCPtr11),   // %7
      494                   [ldc] "r"(ldc),
      495                   [kc]  "r"(kc_adjust),
      496                   [preA]"r"(PREFETCH_A),
      497                   [preB]"r"(PREFETCH_B),
      498                   [preC]"r"(PREFETCH_C)
      499                 : "memory", "cc", "p0", "x4", "z0", "z1", "z2", "z3", "z4", "z5", "z6", "z7", "z8", "z9",
      500                   "z10", "z11", "z12", "z13", "z14", "z15", "z16", "z17", "z18", "z19", "z20", "z21",
      501                   "z22", "z23", "z24", "z25", "z26", "z27", "z28", "z29", "z30", "z31");
      502             
      503             #else
      504                 float* packCPtr0  = packC;
      505                 float* packCPtr1  = packC + 1  * ldc;
      506                 float* packCPtr2  = packC + 2  * ldc;
      507                 float* packCPtr3  = packC + 3  * ldc;
      508                 float* packCPtr4  = packC + 4  * ldc;
      509                 float* packCPtr5  = packC + 5  * ldc;
      510                 float* packCPtr6  = packC + 6  * ldc;
      511                 float* packCPtr7  = packC + 7  * ldc;
      512                 float* packCPtr8  = packC + 8  * ldc;
      513                 float* packCPtr9  = packC + 9  * ldc;
      514                 float* packCPtr10 = packC + 10 * ldc;
      515                 float* packCPtr11 = packC + 11 * ldc;
      516             
      517                 const svbool_t p32_all = svptrue_b32();
      518             
      519                 svfloat32_t va0,   va1, va2;
      520                 svfloat32_t vb0,   vb1;
      521                 svfloat32_t vc00,  vc01;
      522                 svfloat32_t vc10,  vc11;
      523                 svfloat32_t vc20,  vc21;
      524                 svfloat32_t vc30,  vc31;
      525                 svfloat32_t vc40,  vc41;
      526                 svfloat32_t vc50,  vc51;
      527                 svfloat32_t vc60,  vc61;
      528                 svfloat32_t vc70,  vc71;
      529                 svfloat32_t vc80,  vc81;
      530                 svfloat32_t vc90,  vc91;
      531                 svfloat32_t vc100, vc101;
      532                 svfloat32_t vc110, vc111;
      533             
      534                 vc00  = svld1_f32(p32_all, packCPtr0);
      535                 vc01  = svld1_f32(p32_all, packCPtr0 + 16);
      536                 vc10  = svld1_f32(p32_all, packCPtr1);
      537                 vc11  = svld1_f32(p32_all, packCPtr1 + 16);
      538                 vc20  = svld1_f32(p32_all, packCPtr2);
      539                 vc21  = svld1_f32(p32_all, packCPtr2 + 16);
      540                 vc30  = svld1_f32(p32_all, packCPtr3);
      541                 vc31  = svld1_f32(p32_all, packCPtr3 + 16);
      542                 vc40  = svld1_f32(p32_all, packCPtr4);
      543                 vc41  = svld1_f32(p32_all, packCPtr4 + 16);
      544                 vc50  = svld1_f32(p32_all, packCPtr5);
      545                 vc51  = svld1_f32(p32_all, packCPtr5 + 16);
      546                 vc60  = svld1_f32(p32_all, packCPtr6);
      547                 vc61  = svld1_f32(p32_all, packCPtr6 + 16);
      548                 vc70  = svld1_f32(p32_all, packCPtr7);
      549                 vc71  = svld1_f32(p32_all, packCPtr7 + 16);
      550                 vc80  = svld1_f32(p32_all, packCPtr8);
      551                 vc81  = svld1_f32(p32_all, packCPtr8 + 16);
      552                 vc90  = svld1_f32(p32_all, packCPtr9);
      553                 vc91  = svld1_f32(p32_all, packCPtr9 + 16);
      554                 vc100 = svld1_f32(p32_all, packCPtr10);
      555                 vc101 = svld1_f32(p32_all, packCPtr10 + 16);
      556                 vc110 = svld1_f32(p32_all, packCPtr11);
      557                 vc111 = svld1_f32(p32_all, packCPtr11 + 16);
      558             
      559             
      560                 // 计算
      561                 for (int k = 0; k < kc_adjust; k++) {
      562                     va0 = svld1rq(p32_all, packAPtr);
      563                     va1 = svld1rq(p32_all, packAPtr + 4);
      564                     va2 = svld1rq(p32_all, packAPtr + 8);
      565             
      566                     vb0 = svld1_f32(p32_all, packBPtr);
      567                     vb1 = svld1_f32(p32_all, packBPtr + 16);
      568             
      569                     vc00 = svmla_lane_f32(vc00, vb0, va0, 0);
      570                     vc01 = svmla_lane_f32(vc01, vb1, va0, 0);
      571             
      572                     vc10 = svmla_lane_f32(vc10, vb0, va0, 1);
      573                     vc11 = svmla_lane_f32(vc11, vb1, va0, 1);
      574             
      575                     vc20 = svmla_lane_f32(vc20, vb0, va0, 2);
      576                     vc21 = svmla_lane_f32(vc21, vb1, va0, 2);
      577             
      578                     vc30 = svmla_lane_f32(vc30, vb0, va0, 3);
      579                     vc31 = svmla_lane_f32(vc31, vb1, va0, 3);
      580             
      581                     vc40 = svmla_lane_f32(vc40, vb0, va1, 0);
      582                     vc41 = svmla_lane_f32(vc41, vb1, va1, 0);
      583             
      584                     vc50 = svmla_lane_f32(vc50, vb0, va1, 1);
      585                     vc51 = svmla_lane_f32(vc51, vb1, va1, 1);
      586             
      587                     vc60 = svmla_lane_f32(vc60, vb0, va1, 2);
      588                     vc61 = svmla_lane_f32(vc61, vb1, va1, 2);
      589             
      590                     vc70 = svmla_lane_f32(vc70, vb0, va1, 3);
      591                     vc71 = svmla_lane_f32(vc71, vb1, va1, 3);
      592             
      593                     vc80 = svmla_lane_f32(vc80, vb0, va2, 0);
      594                     vc81 = svmla_lane_f32(vc81, vb1, va2, 0);
      595             
      596                     vc90 = svmla_lane_f32(vc90, vb0, va2, 1);
      597                     vc91 = svmla_lane_f32(vc91, vb1, va2, 1);
      598             
      599                     vc100 = svmla_lane_f32(vc100, vb0, va2, 2);
      600                     vc101 = svmla_lane_f32(vc101, vb1, va2, 2);
      601             
      602                     vc110 = svmla_lane_f32(vc110, vb0, va2, 3);
      603                     vc111 = svmla_lane_f32(vc111, vb1, va2, 3);
      604             
      605                     packAPtr += 12;
      606                     packBPtr += 32;
      607                 }
      608             
      609                 // 将结果写回
      610                 svst1_f32(p32_all, packCPtr0, vc00);
      611                 svst1_f32(p32_all, packCPtr0 + 16, vc01);
      612                 svst1_f32(p32_all, packCPtr1, vc10);
      613                 svst1_f32(p32_all, packCPtr1 + 16, vc11);
      614                 svst1_f32(p32_all, packCPtr2, vc20);
      615                 svst1_f32(p32_all, packCPtr2 + 16, vc21);
      616                 svst1_f32(p32_all, packCPtr3, vc30);
      617                 svst1_f32(p32_all, packCPtr3 + 16, vc31);
      618                 svst1_f32(p32_all, packCPtr4, vc40);
      619                 svst1_f32(p32_all, packCPtr4 + 16, vc41);
      620                 svst1_f32(p32_all, packCPtr5, vc50);
      621                 svst1_f32(p32_all, packCPtr5 + 16, vc51);
      622                 svst1_f32(p32_all, packCPtr6, vc60);
      623                 svst1_f32(p32_all, packCPtr6 + 16, vc61);
      624                 svst1_f32(p32_all, packCPtr7, vc70);
      625                 svst1_f32(p32_all, packCPtr7 + 16, vc71);
      626                 svst1_f32(p32_all, packCPtr8, vc80);
      627                 svst1_f32(p32_all, packCPtr8 + 16, vc81);
      628                 svst1_f32(p32_all, packCPtr9, vc90);
      629                 svst1_f32(p32_all, packCPtr9 + 16, vc91);
      630                 svst1_f32(p32_all, packCPtr10, vc100);
      631                 svst1_f32(p32_all, packCPtr10 + 16, vc101);
      632                 svst1_f32(p32_all, packCPtr11, vc110);
      633                 svst1_f32(p32_all, packCPtr11 + 16, vc111);
      634             
      635             #endif
      636             }
      637             
      638             // new version, use broadcast and fmla and loop unroll by 2
      639             void kernel_4x64(int kc_adjust, float *packA, float* packB, float *packC, int ldc, const int PREFETCH_A, const int PREFETCH_B, const int PREFETCH_C) {
      640                 float* packAPtr = packA;
      641                 float* packBPtr = packB;
      642                 float* packCPtr = packC;
      643             
      644             #ifdef _ASM_
      645             
      646                 float* packCPtr0  = packC;
      647                 float* packCPtr1  = packC + 1  * ldc;
      648                 float* packCPtr2  = packC + 2  * ldc;
      649                 float* packCPtr3  = packC + 3  * ldc;
      650             
      651                 asm volatile(
      652                     "ptrue  p0.s  \n"
      653                     "mov    x4, #16 \n"
      654                     "mov    x5, %[kc]    \n"
      655                     "lsr    x6, x5, 0x1  \n"
      656             
      657                     "cmp    w5, #0  \n"
      658                     "b.eq   1f     \n"
      659             
      660             		//"add	%[pC0], %[pC0], 256*2 \n"
      661             		//"prfm	pstl1keep, [%[pC0]] \n"
      662             		//"sub	%[pC0], %[pC0], 256*2 \n"
      663             
      664                     "ld1w	{ z16.s }, p0/z, [%[pC0]]      \n"
      665                     "ld1w	{ z17.s }, p0/z, [%[pC0], #1, MUL VL]    \n"
      666                     "ld1w	{ z18.s }, p0/z, [%[pC0], #2, MUL VL]    \n"
      667                     "ld1w	{ z19.s }, p0/z, [%[pC0], #3, MUL VL]    \n"
      668                     "ld1w	{ z20.s }, p0/z, [%[pC1]]      \n"
      669                     "ld1w	{ z21.s }, p0/z, [%[pC1], #1, MUL VL]    \n"
      670                     "ld1w	{ z22.s }, p0/z, [%[pC1], #2, MUL VL]    \n"
