      957                     "st1w	{ z31.s }, p0, [%[pC11], x4, lsl #2]    \n"
      958             
      959                 "1:                                                 \n"
      960                     
      961                 : [pA]"=&r"(packAPtr),     // %0
      962                   [pB]"=&r"(packBPtr)      // %1
      963                 : "[pA]"   (packAPtr),
      964                   "[pB]"   (packBPtr), 
      965                   [pC0] "r"(packCPtr0),    // %2
