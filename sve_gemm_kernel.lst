      716                     "fmla	z21.s, p0/m, z9.s,  z1.s                \n"
      717                     "fmla	z22.s, p0/m, z10.s, z1.s                \n"
      718                     "fmla	z23.s, p0/m, z11.s, z1.s                \n"
      719             
