      789                     "st1w	{ z30.s }, p0, [%[pC3], #2, MUL VL]    \n"
      790                     "st1w	{ z31.s }, p0, [%[pC3], #3, MUL VL]    \n"
      791             
      792                 "1:                                                \n"
      793                     
      794                 : [pA]"=&r"(packAPtr),     // %0
      795                   [pB]"=&r"(packBPtr)      // %1
      796                 : "[pA]"   (packAPtr),
      797                   "[pB]"   (packBPtr), 
      798                   [pC0] "r"(packCPtr0),    // %2
      799                   [pC1] "r"(packCPtr1),    // %2
      800                   [pC2] "r"(packCPtr2),    // %3
      801                   [pC3] "r"(packCPtr3),    // %3
      802                   [ldc] "r"(ldc),
      803                   [kc]  "r"(kc_adjust),
      804                   [preA]"r"(PREFETCH_A),
      805                   [preB]"r"(PREFETCH_B),
      806                   [preC]"r"(PREFETCH_C)
      807                 : "memory", "cc", "p0", "x4", "z0", "z1", "z2", "z3", "z4", "z5", "z6", "z7", "z8", "z9",
      808                   "z10", "z11", "z12", "z13", "z14", "z15", "z16", "z17", "z18", "z19", "z20", "z21",
      809                   "z22", "z23", "z24", "z25", "z26", "z27", "z28", "z29", "z30", "z31");
      810             
      811             #else
      812             #endif
      813             }
