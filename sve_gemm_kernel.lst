      758                     "fmla	z22.s, p0/m, z14.s, z5.s                \n"
      759                     "fmla	z23.s, p0/m, z15.s, z5.s                \n"
      760             
      761                     "prfm	pldl1keep, [%[pA], #512]                \n"
      762                     "fmla	z24.s, p0/m, z12.s, z6.s                \n"
      763                     "fmla	z25.s, p0/m, z13.s, z6.s                \n"
      764                     "fmla	z26.s, p0/m, z14.s, z6.s                \n"
      765                     "fmla	z27.s, p0/m, z15.s, z6.s                \n"
      766             
