      771             
      772                     "subs   x6, x6, #1                              \n"
      773                     "b.ne   0b                                      \n"
      774                     
      775                     "st1w	{ z16.s }, p0, [%[pC0]]      \n"
      776                     "st1w	{ z17.s }, p0, [%[pC0], #1, MUL VL]    \n"
      777                     "st1w	{ z18.s }, p0, [%[pC0], #2, MUL VL]    \n"
