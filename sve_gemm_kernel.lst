      918             
      919                     "ld1rw	{ z0.s }, p0/z, [%[pA], #40]            \n"
      920             	    "ld1rw	{ z1.s }, p0/z, [%[pA], #44]            \n"
      921             
      922                     "fmla	z28.s, p0/m, z3.s, z0.s                 \n"
      923                     "fmla	z29.s, p0/m, z4.s, z0.s                 \n"
      924             
      925                     "add	%[pB], %[pB], #128                      \n"
      926                     "add	%[pA], %[pA], #48                       \n"
      927                     "subs   x5, x5, #1                              \n"
