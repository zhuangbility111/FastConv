      815             // new version, use broadcast and fmla
      816             void kernel_12x32_v1(int kc_adjust, float *packA, float* packB, float *packC, int ldc, const int PREFETCH_A, const int PREFETCH_B, const int PREFETCH_C) {
      817             
      818                 float* packAPtr = packA;
      819                 float* packBPtr = packB;
      820                 float* packCPtr = packC;
      821             
      822             #ifdef _ASM_
