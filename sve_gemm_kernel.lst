      929                     "fmla	z30.s, p0/m, z3.s, z1.s                 \n"
      930                     "fmla	z31.s, p0/m, z4.s, z1.s                 \n"
      931             
      932                     "b.ne   0b                                      \n"
      933                     
      934                     "st1w	{ z8.s },  p0, [%[pC0]]      \n"  // store C
      935                     "st1w	{ z9.s },  p0, [%[pC0], x4, lsl #2]    \n"
      936                     "st1w	{ z10.s }, p0, [%[pC1]]      \n"
      937                     "st1w	{ z11.s }, p0, [%[pC1], x4, lsl #2]    \n"
      938                     "st1w	{ z12.s }, p0, [%[pC2]]      \n"
      939                     "st1w	{ z13.s }, p0, [%[pC2], x4, lsl #2]    \n"
      940                     "st1w	{ z14.s }, p0, [%[pC3]]      \n"
      941                     "st1w	{ z15.s }, p0, [%[pC3], x4, lsl #2]    \n"
      942                     "st1w	{ z16.s }, p0, [%[pC4]]      \n"
      943                     "st1w	{ z17.s }, p0, [%[pC4], x4, lsl #2]    \n"
      944                     "st1w	{ z18.s }, p0, [%[pC5]]      \n"
      945                     "st1w	{ z19.s }, p0, [%[pC5], x4, lsl #2]    \n"
      946                     "st1w	{ z20.s }, p0, [%[pC6]]      \n"
      947                     "st1w	{ z21.s }, p0, [%[pC6], x4, lsl #2]    \n"
      948                     "st1w	{ z22.s }, p0, [%[pC7]]      \n"
      949                     "st1w	{ z23.s }, p0, [%[pC7], x4, lsl #2]    \n"
      950                     "st1w	{ z24.s }, p0, [%[pC8]]      \n"
      951                     "st1w	{ z25.s }, p0, [%[pC8], x4, lsl #2]    \n"
      952                     "st1w	{ z26.s }, p0, [%[pC9]]      \n"
      953                     "st1w	{ z27.s }, p0, [%[pC9], x4, lsl #2]    \n"
      954                     "st1w	{ z28.s }, p0, [%[pC10]]     \n"
      955                     "st1w	{ z29.s }, p0, [%[pC10], x4, lsl #2]    \n"
